#!/bin/sh
export PATH=/bin:/sbin
mount -t devtmpfs devtmpfs /dev
# Redraw fbcon so inherited boot graphics do not remain over the terminal.
[ ! -c /dev/tty1 ] || printf "\033[2J\033[H" > /dev/tty1
mkdir -p /dev/pts /proc /sys /run /tmp /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
case " $(cat /proc/cmdline) " in
    *" t531.usblog "*) exec /bin/sh /init-usblog;;
esac
# Isolate log collection from USB bring-up with t531.logonly on the command line.
case " $(cat /proc/cmdline) " in
    *" t531.logonly "*)
        mkdir -p /sys/fs/pstore
        mount -t pstore pstore /sys/fs/pstore
        echo '<6>T531_LOG: initramfs reached; USB disabled for this test' > /dev/kmsg
        {
            uname -a
            cat /proc/cmdline
            cat /proc/device-tree/model; echo
            cat /sys/devices/system/cpu/online
            cat /proc/iomem
            cat /proc/partitions
            cat /proc/interrupts
            ls -l /sys/bus/platform/drivers/ramoops /sys/fs/pstore
            for node in /proc/device-tree/reserved-memory/ramoops*; do
                [ -d "$node" ] || continue
                echo "$node"
                for prop in reg console-size record-size; do
                    echo "$prop"; od -An -tx4 "$node/$prop"
                done
            done
            dmesg
        } > /run/t531-boot.log 2>&1
        (
            for attempt in $(seq 1 20); do
                if mount -t ext2 -o rw LABEL=T531_BOOT /newroot; then
                    echo '<6>T531_LOG: microSD boot partition mounted' > /dev/kmsg
                    cp /run/t531-boot.log /newroot/t531-boot.log
                    mkdir -p /newroot/pstore
                    for record in /sys/fs/pstore/*; do
                        [ -f "$record" ] && cp "$record" /newroot/pstore/
                    done
                    dmesg > /newroot/t531-dmesg.log
                    sync
                    umount /newroot
                    echo '<6>T531_LOG: microSD logs saved and unmounted' > /dev/kmsg
                    exit
                fi
                sleep 1
            done
            echo '<3>T531_LOG: microSD logging unavailable' > /dev/kmsg
        ) &
        sleep 30
        echo '<6>T531_LOG: requesting warm reboot after log collection' > /dev/kmsg
        reboot -f
        while :; do sleep 1; done
        ;;
esac
root=
for arg in $(cat /proc/cmdline); do
    case "$arg" in root=*) root=${arg#root=};; esac
done
# ACM is an additional console; enumeration is an on-device acceptance test.
mount -t configfs configfs /sys/kernel/config
G=/sys/kernel/config/usb_gadget/t531
if mkdir -p "$G" 2>/dev/null; then
    echo 0x1d6b > "$G/idVendor"
    echo 0x0104 > "$G/idProduct"
    mkdir -p "$G/strings/0x409" "$G/configs/c.1" "$G/functions/acm.usb0"
    echo 'SM-T531 diagnostics' > "$G/strings/0x409/product"
    ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"
    # Debian provides its own getty after switch_root.
    if [ -z "$root" ]; then
        (
            trap '' HUP
            while :; do
                configured=
                for udc in /sys/class/udc/*; do
                    [ "$(cat "$udc/state" 2>/dev/null)" = configured ] && configured=yes
                done
                if [ "$configured" = yes ] && [ -c /dev/ttyGS0 ]; then
                    sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
                fi
                sleep 1
            done
        ) &
    fi
    bound=
    for i in $(seq 1 15); do
        for udc in /sys/class/udc/*; do
            [ -e "$udc" ] || continue
            (basename "$udc" > "$G/UDC") &
            bound=yes
            break
        done
        [ "$bound" = yes ] && break
        sleep 1
    done
fi
if [ -n "$root" ]; then
    case "$root" in
        /dev/mmcblk*|LABEL=T531_ROOT|UUID=*) ;;
        *) echo 'Unsupported root selector'; root=;;
    esac
fi
if [ -n "$root" ]; then
    for i in $(seq 1 60); do
        if mount -t ext4 -o rw "$root" /newroot; then
            if [ -x /newroot/sbin/init ]; then
                for fs in dev proc sys run; do mount --move /$fs /newroot/$fs; done
                exec switch_root /newroot /sbin/init
            fi
            umount /newroot
            break
        fi
        sleep 1
    done
    echo 'Rootfs unavailable; staying in diagnostic shell'
fi
# Preserve boot evidence on the external rootfs even if ACM is silent.
if mount -t ext4 -o rw LABEL=T531_ROOT /newroot; then
    mkdir -p /newroot/var/log
    { uname -a; cat /proc/device-tree/model; echo;
      cat /sys/devices/system/cpu/online; cat /proc/partitions;
      cat /proc/interrupts; dmesg; } > /newroot/var/log/t531-initramfs.log
    sync
    umount /newroot
fi
uname -a
cat /proc/device-tree/model; echo
cat /sys/devices/system/cpu/online
cat /proc/partitions
while :; do setsid cttyhack sh; sleep 1; done
