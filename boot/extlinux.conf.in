default diagnostic
label diagnostic
    linux /zImage
    initrd /initramfs.cpio.gz
    fdt /qcom-msm8226-samsung-matisse3g.dtb
    append console=tty0 sysctl.kernel.sysrq=0 loglevel=8 ignore_loglevel clk_ignore_unused
label debian
    linux /zImage
    initrd /initramfs.cpio.gz
    fdt /qcom-msm8226-samsung-matisse3g.dtb
    append console=tty0 sysctl.kernel.sysrq=0 root=LABEL=T531_ROOT rootfstype=ext4 rootwait rw clk_ignore_unused
label usb-log
    linux /zImage
    initrd /initramfs.cpio.gz
    fdt /qcom-msm8226-samsung-matisse3g.dtb
    append console=tty0 sysctl.kernel.sysrq=0 loglevel=8 ignore_loglevel clk_ignore_unused t531.usblog
