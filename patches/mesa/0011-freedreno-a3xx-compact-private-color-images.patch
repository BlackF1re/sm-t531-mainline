Subject: [PATCH] freedreno/a3xx: compact single-level private tiled color images

Keep four-row tile alignment without power-of-two height padding for
single-level non-MSAA 2D color images. Other layouts retain their sizing.
Bounded device checks and allocation measurements are recorded in
docs/GRAPHICS-COMPACT-LAYOUT.md; no steady-state FPS gain is claimed.

--- a/src/gallium/drivers/freedreno/a3xx/fd3_resource.c
+++ b/src/gallium/drivers/freedreno/a3xx/fd3_resource.c
@@ -23,7 +23,16 @@
       uint32_t height = u_minify(prsc->height0, level);
       if (rsc->layout.tile_mode) {
          height = align(height, 4);
-         if (prsc->target != PIPE_TEXTURE_CUBE)
+         /* Only mipmapped or layered layouts need the hardware's implicit
+          * power-of-two layer sizing.  A single-level 2D color image is
+          * addressed by its explicit pitch and 4x4 tile rows.
+          */
+         bool compact_2d = prsc->target == PIPE_TEXTURE_2D &&
+                           prsc->last_level == 0 && prsc->array_size == 1 &&
+                           prsc->nr_samples <= 1 &&
+                           prsc->nr_storage_samples <= 1 &&
+                           !util_format_is_depth_or_stencil(format);
+         if (prsc->target != PIPE_TEXTURE_CUBE && !compact_2d)
             height = util_next_power_of_two(height);
       }
 
