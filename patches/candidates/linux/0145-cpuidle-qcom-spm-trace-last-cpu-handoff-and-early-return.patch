From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Subject: [PATCH] cpuidle: qcom-spm: trace last-CPU handoff and early return

The old resume message comes after SAW mode and voltage restoration. A
missing message therefore cannot distinguish failure to return from SCM
from a stall in the early register restore. Add optional console markers
before the final cache flush and immediately after cpu_suspend returns.
Keep tracing off by default and do not change the power sequence.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/cpuidle/cpuidle-qcom-spm.c b/drivers/cpuidle/cpuidle-qcom-spm.c
--- a/drivers/cpuidle/cpuidle-qcom-spm.c
+++ b/drivers/cpuidle/cpuidle-qcom-spm.c
@@ -137,11 +137,19 @@
 static unsigned int l2_sleep_mode;
 module_param(l2_sleep_mode, uint, 0644);
 MODULE_PARM_DESC(l2_sleep_mode, "MSM8226 deep: 0 standalone, 1 retention, 2 GDHS, 3 RPM");
+static bool sleep_trace;
+module_param(sleep_trace, bool, 0644);
+MODULE_PARM_DESC(sleep_trace, "Trace MSM8226 last-CPU SCM handoff and early return");
 
 static int qcom_l2_collapse(unsigned long scm_flags)
 {
+	if (sleep_trace)
+		pr_info("MSM8226: SCM entry flags=%#lx\n", scm_flags);
+	/* Keep the final cache clean after the optional console write. */
 	flush_cache_all();
 	qcom_scm_cpu_power_down(scm_flags);
+	if (sleep_trace)
+		pr_info("MSM8226: SCM power-down fell through\n");
 	return -EAGAIN;
 }
 
@@ -187,6 +195,8 @@
 	spm_set_low_power_mode(suspend_cpu_spm, PM_SLEEP_MODE_SPC);
 	pr_info("MSM8226: entering L2 sleep mode %u\n", l2_sleep_mode);
 	ret = cpu_suspend(scm_flags, qcom_l2_collapse);
+	if (sleep_trace)
+		pr_info("MSM8226: CPU resume reached, ret=%d\n", ret);
 	spm_set_low_power_mode(suspend_l2_spm, PM_SLEEP_MODE_STBY);
 	spm_set_low_power_mode(suspend_cpu_spm, PM_SLEEP_MODE_STBY);
 	voltage_ret = spm_restore_cpu_voltage(suspend_l2_spm);
