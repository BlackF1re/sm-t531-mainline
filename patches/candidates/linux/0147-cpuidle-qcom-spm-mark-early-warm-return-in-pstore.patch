From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Subject: [PATCH] cpuidle: qcom-spm: trace early matisse3g warm return

When sleep_trace is enabled, install a temporary CPU0 warm-entry trampoline
which appends T531_WARM_ENTRY to the existing ECC-free ramoops console
before branching to cpu_resume_arm. Validate the board and fixed console
layout against DT before arming; validate the persistent RAM header before
writing. Only the last CPU is active with IRQs off, so the console writer
cannot run concurrently. Restore the ordinary CPU0 vector after the cycle.
CPU1-3 hotplug vectors remain untouched.

Keep stage counters in the stock IMEM PC debug area for live inspection.
The bootloader overwrites IMEM, so use the ramoops marker after reset.
A missing marker does not distinguish failure to start the CPU from a DDR
instruction-fetch failure before the trampoline. Disabled by default.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/arch/arm/mach-qcom/Makefile b/arch/arm/mach-qcom/Makefile
index b839201c9..7140cdeb0 100644
--- a/arch/arm/mach-qcom/Makefile
+++ b/arch/arm/mach-qcom/Makefile
@@ -1,2 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-$(CONFIG_SMP)	+= platsmp.o
+obj-$(CONFIG_ARM_CPU_SUSPEND) += sleep-msm8226.o
diff --git a/drivers/cpuidle/cpuidle-qcom-spm.c b/drivers/cpuidle/cpuidle-qcom-spm.c
index c4ea9a2d6..cdd6f02a5 100644
--- a/drivers/cpuidle/cpuidle-qcom-spm.c
+++ b/drivers/cpuidle/cpuidle-qcom-spm.c
@@ -11,6 +11,7 @@
 #include <linux/io.h>
 #include <linux/slab.h>
 #include <linux/of.h>
+#include <linux/of_address.h>
 #include <linux/of_platform.h>
 #include <linux/err.h>
 #include <linux/platform_device.h>
@@ -141,10 +142,56 @@ static bool sleep_trace;
 module_param(sleep_trace, bool, 0644);
 MODULE_PARM_DESC(sleep_trace, "Trace MSM8226 last-CPU SCM handoff and early return");
 
+#if defined(CONFIG_ARM) && defined(CONFIG_ARCH_QCOM)
+extern void msm8226_resume_trace(void);
+static void __iomem *resume_trace_base;
+static bool resume_trace_armed;
+
+static void msm8226_trace_stage(u32 stage)
+{
+	if (resume_trace_armed)
+		writel(stage, resume_trace_base + 4);
+}
+
+static int msm8226_trace_begin(void)
+{
+	int ret;
+
+	if (!sleep_trace || !resume_trace_base)
+		return 0;
+	ret = qcom_scm_set_warm_boot_addr_cpu(msm8226_resume_trace, 0);
+	if (ret)
+		return ret;
+	resume_trace_armed = true;
+	/* Only the stock CPU0 debug-counter slot, not the reboot-mode word. */
+	writel(0x5453504d, resume_trace_base);
+	writel(l2_sleep_mode, resume_trace_base + 8);
+	msm8226_trace_stage(0x10);
+	return 0;
+}
+
+static int msm8226_trace_end(void)
+{
+	int ret;
+
+	if (!resume_trace_armed)
+		return 0;
+	ret = qcom_scm_set_warm_boot_addr_cpu(cpu_resume_arm, 0);
+	msm8226_trace_stage(ret ? 0x4f : 0x40);
+	resume_trace_armed = false;
+	return ret;
+}
+#else
+static void msm8226_trace_stage(u32 stage) { }
+static int msm8226_trace_begin(void) { return 0; }
+static int msm8226_trace_end(void) { return 0; }
+#endif
+
 static int qcom_l2_collapse(unsigned long scm_flags)
 {
 	if (sleep_trace)
 		pr_info("MSM8226: SCM entry flags=%#lx\n", scm_flags);
+	msm8226_trace_stage(0x11);
 	/* Keep the final cache clean after the optional console write. */
 	flush_cache_all();
 	qcom_scm_cpu_power_down(scm_flags);
@@ -191,10 +238,15 @@ static int qcom_spm_suspend_enter(suspend_state_t state)
 	if (ret)
 		goto cpu_exit;
 
+	ret = msm8226_trace_begin();
+	if (ret)
+		goto cluster_exit;
+
 	spm_set_low_power_mode(suspend_l2_spm, mode);
 	spm_set_low_power_mode(suspend_cpu_spm, PM_SLEEP_MODE_SPC);
 	pr_info("MSM8226: entering L2 sleep mode %u\n", l2_sleep_mode);
 	ret = cpu_suspend(scm_flags, qcom_l2_collapse);
+	msm8226_trace_stage(0x30);
 	if (sleep_trace)
 		pr_info("MSM8226: CPU resume reached, ret=%d\n", ret);
 	spm_set_low_power_mode(suspend_l2_spm, PM_SLEEP_MODE_STBY);
@@ -204,6 +256,10 @@ static int qcom_spm_suspend_enter(suspend_state_t state)
 		ret, voltage_ret);
 	if (!ret)
 		ret = voltage_ret;
+	voltage_ret = msm8226_trace_end();
+	if (!ret)
+		ret = voltage_ret;
+cluster_exit:
 	cpu_cluster_pm_exit();
 cpu_exit:
 	cpu_pm_exit();
@@ -278,6 +334,31 @@ static int spm_cpuidle_drv_probe(struct platform_device *pdev)
 		return ret;
 #endif
 
+#if defined(CONFIG_ARM) && defined(CONFIG_ARCH_QCOM) && defined(CONFIG_SUSPEND)
+	if (of_machine_is_compatible("samsung,matisse3g")) {
+		struct device_node *np;
+		struct resource res;
+		u32 console_size = 0, record_size = 0, ecc_size = 0;
+		bool valid = false;
+
+		np = of_find_compatible_node(NULL, NULL, "ramoops");
+		if (np) {
+			of_property_read_u32(np, "console-size", &console_size);
+			of_property_read_u32(np, "record-size", &record_size);
+			of_property_read_u32(np, "ecc-size", &ecc_size);
+			valid = !of_address_to_resource(np, 0, &res) &&
+				res.start == 0x2ff80000 && resource_size(&res) == 0x80000 &&
+				console_size == 0x40000 && record_size == 0x20000 && !ecc_size;
+			of_node_put(np);
+		}
+		/* The MMU-off trampoline has a fixed, verified RAM-console layout. */
+		if (valid) {
+			resume_trace_base = devm_ioremap(&pdev->dev, 0xfe805664, 0x10);
+			if (!resume_trace_base)
+				return -ENOMEM;
+		}
+	}
+#endif
 	ret = qcom_scm_set_warm_boot_addr(cpu_resume_arm);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "set warm boot addr failed");
diff --git a/arch/arm/mach-qcom/sleep-msm8226.S b/arch/arm/mach-qcom/sleep-msm8226.S
new file mode 100644
index 000000000..29cbbb521
--- /dev/null
+++ b/arch/arm/mach-qcom/sleep-msm8226.S
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Opt-in MSM8226 warm-return diagnostic, using the stock PC counter area. */
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+
+	.arm
+ENTRY(msm8226_resume_trace)
+	/* Stock CPU0 PC debug counters: IMEM 0xfe805664..0xfe805673. */
+	movw	r0, #0x5668
+	movt	r0, #0xfe80
+	mov	r1, #0x20
+	str	r1, [r0]
+	dsb	sy
+
+	/* Board-specific ramoops console, checked against DT before arming. */
+	movw	r0, #0
+	movt	r0, #0x2ffc
+	ldr	r1, [r0]
+	movw	r2, #0x4244
+	movt	r2, #0x4347
+	cmp	r1, r2
+	bne	.Lresume
+	/* Capacity = 0x40000 console bytes minus its 12-byte header, no ECC. */
+	movw	r3, #0xfff4
+	movt	r3, #3
+	ldr	r1, [r0, #4]
+	ldr	r7, [r0, #8]
+	cmp	r1, r3
+	bhs	.Lresume
+	cmp	r7, r3
+	bhi	.Lresume
+	adr	r4, .Lwarm_message
+	add	r5, r0, #12
+	mov	r6, #(.Lwarm_end - .Lwarm_message)
+.Lappend:
+	ldrb	r2, [r4], #1
+	strb	r2, [r5, r1]
+	add	r1, r1, #1
+	cmp	r1, r3
+	moveq	r1, #0
+	subs	r6, r6, #1
+	bne	.Lappend
+	add	r7, r7, #(.Lwarm_end - .Lwarm_message)
+	cmp	r7, r3
+	movhi	r7, r3
+	dsb	sy
+	str	r1, [r0, #4]
+	str	r7, [r0, #8]
+	dsb	sy
+.Lresume:
+	b	cpu_resume_arm
+.Lwarm_message:
+	.ascii "\nT531_WARM_ENTRY\n"
+.Lwarm_end:
+	.align 2
+ENDPROC(msm8226_resume_trace)
