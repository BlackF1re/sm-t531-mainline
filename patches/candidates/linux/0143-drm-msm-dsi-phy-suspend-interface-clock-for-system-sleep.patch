From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi/phy: opt in to interface-clock sleep gating

The PM clock list leaves a non-sleeping branch prepared while disabled.
Its RPM ancestor therefore retains an XO sleep vote. Manage the interface
clock with balanced prepare/unprepare. Add late/early system callbacks
for controlled validation of the fully clock-gated collapse path.

Runtime prepare/unprepare differs from the production driver even with
the parameter off: N is not a legacy-clock baseline. System gating is
disabled by default. The dsi_phy_sleep_gating parameter
is a diagnostic opt-in, not an accepted power policy. Pair resume with
the actual suspend outcome even if the parameter changes. Initial tests
with unconditional gating hang in RPM collapse and require manual reset.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -5,7 +5,6 @@
 
 #include <linux/clk-provider.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <dt-bindings/phy/phy.h>
 
@@ -687,13 +686,10 @@
 	if (ret)
 		return ret;
 
-	ret = devm_pm_clk_create(dev);
-	if (ret)
-		return ret;
-
-	ret = pm_clk_add(dev, "iface");
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Unable to get iface clk\n");
+	phy->iface_clk = devm_clk_get(dev, "iface");
+	if (IS_ERR(phy->iface_clk))
+		return dev_err_probe(dev, PTR_ERR(phy->iface_clk),
+				     "Unable to get iface clk\n");
 
 	if (phy->cfg->ops.pll_init) {
 		ret = phy->cfg->ops.pll_init(phy);
@@ -711,8 +707,61 @@
 	return 0;
 }
 
+/* Opt-in controls system callbacks only; runtime clock PM also differs. */
+static bool phy_sleep_gating;
+module_param_named(dsi_phy_sleep_gating, phy_sleep_gating, bool, 0644);
+MODULE_PARM_DESC(dsi_phy_sleep_gating,
+		"Experimental DSI PHY interface-clock release in system sleep");
+
+static int dsi_phy_suspend_late(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+	int ret;
+
+	if (phy->system_sleep_suspended)
+		return -EBUSY;
+	if (!phy_sleep_gating)
+		return 0;
+
+	ret = pm_runtime_force_suspend(dev);
+	if (!ret)
+		phy->system_sleep_suspended = true;
+	return ret;
+}
+
+static int dsi_phy_resume_early(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+	int ret;
+
+	if (!phy->system_sleep_suspended)
+		return 0;
+
+	ret = pm_runtime_force_resume(dev);
+	if (!ret)
+		phy->system_sleep_suspended = false;
+	return ret;
+}
+
+static int dsi_phy_runtime_suspend(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	/* Unprepare too: RPM parents keep their vote while prepared. */
+	clk_disable_unprepare(phy->iface_clk);
+	return 0;
+}
+
+static int dsi_phy_runtime_resume(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(phy->iface_clk);
+}
+
 static const struct dev_pm_ops dsi_phy_pm_ops = {
-	SET_RUNTIME_PM_OPS(pm_clk_suspend, pm_clk_resume, NULL)
+	SET_LATE_SYSTEM_SLEEP_PM_OPS(dsi_phy_suspend_late, dsi_phy_resume_early)
+	SET_RUNTIME_PM_OPS(dsi_phy_runtime_suspend, dsi_phy_runtime_resume, NULL)
 };
 
 static struct platform_driver dsi_phy_platform_driver = {
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -96,6 +96,8 @@
 
 struct msm_dsi_phy {
 	struct platform_device *pdev;
+	struct clk *iface_clk;
+	bool system_sleep_suspended;
 	void __iomem *base;
 	void __iomem *pll_base;
 	void __iomem *reg_base;
