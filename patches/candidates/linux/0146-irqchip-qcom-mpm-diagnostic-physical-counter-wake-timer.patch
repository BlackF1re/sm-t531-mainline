From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Subject: [PATCH] irqchip: qcom-mpm: add opt-in legacy wake timer diagnostic

Distinguish PMIC RTC wake routing from CPU restore in an XO-off collapse.
Use the physical architectural counter deadline, matching the vendor MPM
protocol. The diagnostic is disabled by default and limited to 60 seconds.
Reject invalid deadlines before entering collapse. Keep a separate PMIC
RTC alarm as a backup during functional tests. This is not a power policy.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/irqchip/irq-qcom-mpm.c b/drivers/irqchip/irq-qcom-mpm.c
index 8dc894695..6e43a87c5 100644
--- a/drivers/irqchip/irq-qcom-mpm.c
+++ b/drivers/irqchip/irq-qcom-mpm.c
@@ -4,6 +4,9 @@
  * Copyright (c) 2010-2020, The Linux Foundation. All rights reserved.
  */
 
+#include <clocksource/arm_arch_timer.h>
+#include <asm/arch_timer.h>
+
 #include <linux/cpu.h>
 #include <linux/delay.h>
 #include <linux/err.h>
@@ -91,6 +94,10 @@ struct qcom_mpm_priv {
 };
 
 static struct qcom_mpm_priv *legacy_mpm;
+/* Diagnostic alternative to PMIC RTC wake; never enabled at boot. */
+static unsigned int legacy_timer_seconds;
+module_param(legacy_timer_seconds, uint, 0644);
+MODULE_PARM_DESC(legacy_timer_seconds, "Legacy MPM diagnostic wake timer (0=off, max 60 seconds)");
 
 static u32 qcom_mpm_read(struct qcom_mpm_priv *priv, unsigned int reg,
 			 unsigned int index)
@@ -309,15 +316,26 @@ static int qcom_mpm_notify(struct qcom_mpm_priv *priv)
 		qcom_mpm_write(priv, MPM_REG_STATUS, i, 0);
 
 	if (priv->legacy_saw) {
+		u64 expiry = U64_MAX;
+
 		dev_dbg(priv->mbox_client.dev,
 			"legacy MPM enable=%08x/%08x polarity=%08x/%08x\n",
 			qcom_mpm_read(priv, MPM_REG_ENABLE, 0),
 			qcom_mpm_read(priv, MPM_REG_ENABLE, 1),
 			qcom_mpm_read(priv, MPM_REG_POLARITY, 0),
 			qcom_mpm_read(priv, MPM_REG_POLARITY, 1));
-		/* PMIC RTC/key provide the system alarm, not a stale vMPM timer. */
-		writel_relaxed(U32_MAX, priv->base);
-		writel_relaxed(U32_MAX, priv->base + sizeof(u32));
+		if (legacy_timer_seconds) {
+			expiry = __arch_counter_get_cntpct() +
+				 (u64)arch_timer_get_rate() * legacy_timer_seconds;
+			dev_info(priv->mbox_client.dev,
+				 "MPM timer=%016llx enable=%08x/%08x polarity=%08x/%08x\n",
+				 expiry, qcom_mpm_read(priv, MPM_REG_ENABLE, 0),
+				 qcom_mpm_read(priv, MPM_REG_ENABLE, 1),
+				 qcom_mpm_read(priv, MPM_REG_POLARITY, 0),
+				 qcom_mpm_read(priv, MPM_REG_POLARITY, 1));
+		}
+		writel_relaxed(lower_32_bits(expiry), priv->base);
+		writel_relaxed(upper_32_bits(expiry), priv->base + sizeof(u32));
 		wmb();
 	}
 
@@ -339,6 +357,10 @@ int qcom_mpm_prepare_suspend(void)
 	if (num_online_cpus() != 1 || !irqs_disabled())
 		return -EBUSY;
 
+	if (legacy_timer_seconds > 60 ||
+	    (legacy_timer_seconds && !arch_timer_get_rate()))
+		return -EINVAL;
+
 	return qcom_mpm_notify(legacy_mpm);
 }
 EXPORT_SYMBOL_GPL(qcom_mpm_prepare_suspend);
