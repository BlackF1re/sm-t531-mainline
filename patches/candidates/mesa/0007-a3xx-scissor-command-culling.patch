+static void
+fd3_emit_scissor_tile(struct fd_batch *batch, const struct fd_tile *tile)
+{
+   foreach_subpass (subpass, batch) {
+      struct pipe_scissor_state *s = &subpass->a3xx_scissor;
+      /* Extra commands appended outside draw_vbo make this chunk uncullable. */
+      bool cull = !batch->query_providers_used && subpass->a3xx_cullable &&
+                  subpass->a3xx_expected_end == subpass->draw->cur;
+      if (cull && (s->maxx < tile->xoff || s->maxy < tile->yoff ||
+                   s->minx >= tile->xoff + tile->bin_w ||
+                   s->miny >= tile->yoff + tile->bin_h))
+      {
+         batch->a3xx_skipped_ibs++;
+         continue;
+      }
+      if (!fd_ringbuffer_empty(subpass->draw)) {
+         fd3_emit_ib(batch->gmem, subpass->draw);
+         batch->a3xx_emitted_ibs++;
+      }
+   }
+}
+
+static void
+fd3_scissor_stats(struct fd_batch *batch)
+{
+   if (getenv("FD3_SCISSOR_LOG"))
+      fprintf(stderr, "T531_SCISSOR w=%u h=%u draws=%u enabled=%u emitted=%u skipped=%u\n",
+              batch->framebuffer.width, batch->framebuffer.height,
+              batch->num_draws, batch->a3xx_scissor_ib,
+              batch->a3xx_emitted_ibs, batch->a3xx_skipped_ibs);
+}
+
+static void
+fd3_emit_scissor_sysmem(struct fd_batch *batch)
+{
+   foreach_subpass (subpass, batch) {
+      if (!fd_ringbuffer_empty(subpass->draw))
+         fd3_emit_ib(batch->gmem, subpass->draw);
+   }
+}
+
 void
 fd3_gmem_init(struct pipe_context *pctx) disable_thread_safety_analysis
 {
    struct fd_context *ctx = fd_context(pctx);
 
+   if (debug_get_bool_option("FD3_SCISSOR_IB", false)) {
+      ctx->emit_tile = fd3_emit_scissor_tile;
+      ctx->emit_tile_fini = fd3_scissor_stats;
+      ctx->emit_sysmem = fd3_emit_scissor_sysmem;
+   }
    ctx->emit_sysmem_prep = fd3_emit_sysmem_prep;
    ctx->emit_tile_init = fd3_emit_tile_init;
    ctx->emit_tile_prep = fd3_emit_tile_prep;
