Subject: [CANDIDATE] freedreno/a3xx: test fragment mediump lowering on A305B

Experimental private-build candidate, not a production feature claim.
A305B has separate half/full register files and the IR3 backend contains
half-ALU and half render-output encodings. The current shader capability
path never requests mediump lowering on this chip; measured fragment half
ALU counts were zero. Test the existing lowering machinery on fragment
shaders only, preserving highp declarations and the existing INT16 policy.

This does not establish complete compiler support or a performance benefit.
It requires generated-ISA inspection, mixed-precision/branch correctness
checks and offscreen measurements before any graphical-session deployment.
FD_MESA_DEBUG=nofp16 retains a same-binary 32-bit frontend control.

--- a/src/gallium/drivers/freedreno/freedreno_screen.c
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c
@@ -282,8 +282,10 @@
    case PIPE_SHADER_CAP_INT16:
    case PIPE_SHADER_CAP_FP16:
       return (
-         (is_a5xx(screen) || is_a6xx(screen)) &&
-         (shader == PIPE_SHADER_COMPUTE || shader == PIPE_SHADER_FRAGMENT) &&
+         (((is_a5xx(screen) || is_a6xx(screen)) &&
+           (shader == PIPE_SHADER_COMPUTE || shader == PIPE_SHADER_FRAGMENT)) ||
+          (param == PIPE_SHADER_CAP_FP16 && screen->chip_id == 0x03000512 &&
+           shader == PIPE_SHADER_FRAGMENT)) &&
          !FD_DBG(NOFP16));
    case PIPE_SHADER_CAP_MAX_TEXTURE_SAMPLERS:
    case PIPE_SHADER_CAP_MAX_SAMPLER_VIEWS:
--- a/src/freedreno/ir3/ir3_compiler.c
+++ b/src/freedreno/ir3/ir3_compiler.c
@@ -353,7 +353,8 @@
    /* 16-bit ALU op generation is mostly controlled by frontend compiler options, but
     * this core NIR option enables some optimizations of 16-bit operations.
     */
-   if (compiler->gen >= 5 && !(ir3_shader_debug & IR3_DBG_NOFP16))
+   if ((compiler->gen >= 5 || dev_id->chip_id == 0x03000512) &&
+       !(ir3_shader_debug & IR3_DBG_NOFP16))
       compiler->nir_options.support_16bit_alu = true;
 
    compiler->nir_options.support_indirect_inputs = (uint8_t)BITFIELD_MASK(PIPE_SHADER_TYPES);
