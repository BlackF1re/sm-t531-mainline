From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Mon, 12 Oct 2026 12:00:00 +0700
Subject: [PATCH] ARM: dts: qcom: matisse3g: describe charging and WCNSS

Describe the populated SMB358 GPIO-I2C bus and SM5502 source detector
from the SM-T531 Rev02 live vendor DT. Keep SDP at 500 mA and use the
vendor 1800 mA input ceiling for dedicated chargers under hardware AICL.

Describe the confirmed battery float voltage, PM8226 ADC channels and
Rev02 thermistor lookup table. Use the generic ADC thermal driver and
the vendor -5/60 C stop and 0/45 C restart thresholds without enabling
the unconnected SMB358 thermistor input.

Describe Pronto v1, SMP2P/SMD channels, GPIO40-44 and regulator wiring
from the live vendor DT and board-matisse-gpiomux.c. Keep firmware, NV
calibration and per-device MAC addresses outside the repository.
The WCN3660 compatibility remains provisional pending a chip-ID read.

Set the battery charge ceiling to 1.8 A, below the vendor 2.1 A
limit. The separate input ceiling and hardware AICL bound source draw.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
--- a/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-matisse3g.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-matisse3g.dts
@@ -149,3 +149,196 @@
 	status = "okay";
 	iommus = <&gpu_smmu 0>;
 };
+
+/ {
+	i2c-charger {
+		compatible = "i2c-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		sda-gpios = <&tlmm 10 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+
+		charger: charger@6a {
+			compatible = "summit,smb358";
+			reg = <0x6a>;
+			summit,enable-usb-charging;
+			monitored-battery = <&battery>;
+			io-channels = <&battery_therm>;
+			io-channel-names = "battery-temperature";
+			summit,usb-current-limit-microamp = <1800000>;
+			extcon = <&muic>;
+		};
+	};
+};
+
+/ {
+	smp2p-wcnss {
+		compatible = "qcom,smp2p";
+		qcom,smem = <451>, <431>;
+		interrupt-parent = <&intc>;
+		interrupts = <GIC_SPI 143 IRQ_TYPE_EDGE_RISING>;
+		mboxes = <&apcs 18>;
+		qcom,local-pid = <0>;
+		qcom,remote-pid = <4>;
+
+		wcnss_smp2p_out: master-kernel {
+			qcom,entry-name = "master-kernel";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		wcnss_smp2p_in: slave-kernel {
+			qcom,entry-name = "slave-kernel";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+};
+
+&soc {
+	pronto: remoteproc@fb204000 {
+		compatible = "qcom,pronto-v1-pil", "qcom,pronto";
+		reg = <0xfb204000 0x2000>, <0xfb202000 0x1000>, <0xfb21b000 0x3000>;
+		reg-names = "ccu", "dxe", "pmu";
+		memory-region = <&{/reserved-memory/wcnss@d200000}>;
+		firmware-name = "qcom/matisse3g/wcnss.mdt";
+
+		interrupts-extended = <&intc GIC_SPI 149 IRQ_TYPE_EDGE_RISING>,
+				      <&wcnss_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&wcnss_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+				      <&wcnss_smp2p_in 2 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "wdog", "fatal", "ready", "handover";
+		power-domains = <&rpmpd MSM8226_VDDCX>;
+		power-domain-names = "cx";
+		vddmx-supply = <&pm8226_l3>;
+		vddpx-supply = <&pm8226_l6>;
+		qcom,smem-states = <&wcnss_smp2p_out 0>;
+		qcom,smem-state-names = "stop";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_default_state>;
+
+		iris {
+			compatible = "qcom,wcn3660";
+			clocks = <&rpmcc RPM_SMD_CXO_A2>;
+			clock-names = "xo";
+			vddxo-supply = <&pm8226_l10>;
+			vddrfa-supply = <&pm8226_l24>;
+			vddpa-supply = <&pm8226_l16>;
+			vdddig-supply = <&pm8226_l24>;
+		};
+
+		smd-edge {
+			interrupts = <GIC_SPI 142 IRQ_TYPE_EDGE_RISING>;
+			mboxes = <&apcs 17>;
+			qcom,smd-edge = <6>;
+
+			wcnss {
+				compatible = "qcom,wcnss";
+				qcom,smd-channels = "WCNSS_CTRL";
+				qcom,mmio = <&pronto>;
+				firmware-name = "qcom/matisse3g/WCNSS_qcom_wlan_nv.bin";
+
+				wifi {
+					compatible = "qcom,wcnss-wlan";
+					interrupts = <GIC_SPI 145 IRQ_TYPE_EDGE_RISING>,
+						     <GIC_SPI 146 IRQ_TYPE_EDGE_RISING>;
+					interrupt-names = "tx", "rx";
+					qcom,smem-states = <&apps_smsm 10>, <&apps_smsm 9>;
+					qcom,smem-state-names = "tx-enable", "tx-rings-empty";
+				};
+			};
+		};
+	};
+};
+
+&tlmm {
+	wlan_default_state: wlan-default-state {
+		pins = "gpio40", "gpio41", "gpio42", "gpio43", "gpio44";
+		function = "wlan";
+		drive-strength = <6>;
+		bias-pull-down;
+	};
+};
+
+&pm8226_l16 {
+	regulator-allow-set-load;
+};
+
+&pm8226_l24 {
+	regulator-allow-set-load;
+};
+
+/ {
+	battery: battery-cell {
+		compatible = "simple-battery";
+		constant-charge-voltage-max-microvolt = <4340000>;
+		constant-charge-current-max-microamp = <1800000>;
+		operating-range-celsius = <(-5) 60>;
+		alert-celsius = <0 45>;
+	};
+
+	battery_therm: battery-thermal-sensor {
+		compatible = "generic-adc-thermal";
+		#io-channel-cells = <0>;
+		#thermal-sensor-cells = <0>;
+		io-channels = <&pm8226_vadc VADC_LR_MUX1_BAT_THERM>;
+		io-channel-names = "sensor-channel";
+		temperature-lookup-table = <
+			(-20000) 41619
+			(-15000) 41123
+			(-10000) 40523
+			(-5000) 39822
+			(-4000) 39687
+			(-3000) 39540
+			(-1000) 39229
+			0 38989
+			1000 38795
+			2000 38626
+			3000 38448
+			4000 38219
+			5000 38025
+			10000 37054
+			15000 36049
+			20000 34950
+			25000 33858
+			30000 32823
+			35000 31807
+			40000 30912
+			45000 30101
+			50000 29342
+			55000 28724
+			60000 28178
+			65000 27669
+			70000 27281>;
+	};
+
+	thermal-zones {
+		battery-temp {
+			polling-delay-passive = <1000>;
+			polling-delay = <5000>;
+			thermal-sensors = <&battery_therm>;
+		};
+	};
+};
+
+&pm8226_vadc {
+	channel@0 {
+		reg = <VADC_USBIN>;
+		qcom,pre-scaling = <1 10>;
+		label = "usb_in";
+	};
+
+	channel@6 {
+		reg = <VADC_VBAT_SNS>;
+		qcom,pre-scaling = <1 3>;
+		label = "vbat_sns";
+	};
+
+	channel@30 {
+		reg = <VADC_LR_MUX1_BAT_THERM>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "batt_therm";
+	};
+};
