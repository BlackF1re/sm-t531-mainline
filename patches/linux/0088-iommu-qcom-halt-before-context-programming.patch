From: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Date: Wed, 14 Oct 2026 12:00:00 +0700
Subject: [PATCH] iommu: qcom_iommu: halt while programming context banks

Backport the per-instance micro-MMU halt handshake from MSM8974
series v1 patch08. Stop accepting new client transactions and wait for
IDLE before changing the context registers. Unhalt after the context
has been programmed. Never halt around TrustZone global restoration.
No instance enables this helper in this patch.

Use the already mapped HLOS implementation-only resource. Adapt the
upstream diagnostic-only timeout into a propagated error: if quiescence
cannot be established, unhalt and leave the context unchanged. Free the
new page table on failed attach and propagate runtime-resume failures.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Link: https://lore.kernel.org/r/20260809-msm8974-iommu-upstream-v1-8-87f5cd492560@oss.qualcomm.com
[BlackF1re: implementation-only window; refuse to reprogram after timeout]

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/iommu/arm/arm-smmu/qcom_iommu.c b/drivers/iommu/arm/arm-smmu/qcom_iommu.c
index c0f619611..fe59bf191 100644
--- a/drivers/iommu/arm/arm-smmu/qcom_iommu.c
+++ b/drivers/iommu/arm/arm-smmu/qcom_iommu.c
@@ -34,6 +34,8 @@
 #include "arm-smmu.h"
 
 #define SMMU_INTR_SEL_NS     0x2000
+#define MICRO_MMU_CTRL_HALT_REQ BIT(2)
+#define MICRO_MMU_CTRL_IDLE BIT(3)
 
 enum qcom_iommu_clk {
 	CLK_IFACE,
@@ -52,6 +54,7 @@ struct qcom_iommu_bfb_reg {
 struct qcom_iommu_cfg {
 	/* Faulting transactions must terminate rather than stall. */
 	bool no_stall;
+	bool halt;
 	u32 actlr;
 	const struct qcom_iommu_bfb_reg *bfb;
 	unsigned int num_bfb;
@@ -255,9 +258,47 @@ static void qcom_iommu_bfb_setup(struct qcom_iommu_dev *qcom_iommu)
 	wmb();
 }
 
-static void qcom_iommu_program_ctx(struct qcom_iommu_dev *qcom_iommu,
+static void qcom_iommu_unhalt(struct qcom_iommu_dev *qcom_iommu)
+{
+	void __iomem *reg;
+
+	if (!qcom_iommu->cfg || !qcom_iommu->cfg->halt)
+		return;
+	reg = qcom_iommu->impl_base;
+	/* Complete context writes before releasing the translation front-end. */
+	wmb();
+	writel(readl(reg) & ~MICRO_MMU_CTRL_HALT_REQ, reg);
+}
+
+static int qcom_iommu_halt(struct qcom_iommu_dev *qcom_iommu)
+{
+	void __iomem *reg;
+	u32 val;
+	int ret;
+
+	if (!qcom_iommu->cfg || !qcom_iommu->cfg->halt)
+		return 0;
+	if (!qcom_iommu->impl_base)
+		return -ENODEV;
+	reg = qcom_iommu->impl_base;
+	writel(readl(reg) | MICRO_MMU_CTRL_HALT_REQ, reg);
+	ret = readl_poll_timeout(reg, val, val & MICRO_MMU_CTRL_IDLE, 0, 100000);
+	if (ret) {
+		dev_err(qcom_iommu->dev, "timeout waiting for micro-MMU halt\n");
+		qcom_iommu_unhalt(qcom_iommu);
+	}
+	return ret;
+}
+
+static int qcom_iommu_program_ctx(struct qcom_iommu_dev *qcom_iommu,
 				   struct qcom_iommu_ctx *ctx)
 {
+	int ret;
+
+	ret = qcom_iommu_halt(qcom_iommu);
+	if (ret)
+		return ret;
+
 	/* Disable context bank before programming */
 	iommu_writel(ctx, ARM_SMMU_CB_SCTLR, 0);
 
@@ -284,6 +325,8 @@ static void qcom_iommu_program_ctx(struct qcom_iommu_dev *qcom_iommu,
 
 	/* SCTLR */
 	iommu_writel(ctx, ARM_SMMU_CB_SCTLR, ctx->sctlr);
+	qcom_iommu_unhalt(qcom_iommu);
+	return 0;
 }
 
 static int qcom_iommu_init_domain(struct iommu_domain *domain,
@@ -376,7 +419,9 @@ static int qcom_iommu_init_domain(struct iommu_domain *domain,
 
 		ctx->sctlr = reg;
 
-		qcom_iommu_program_ctx(qcom_iommu, ctx);
+		ret = qcom_iommu_program_ctx(qcom_iommu, ctx);
+		if (ret)
+			goto out_clear_iommu;
 
 		ctx->domain = domain;
 	}
@@ -389,6 +434,8 @@ static int qcom_iommu_init_domain(struct iommu_domain *domain,
 	return 0;
 
 out_clear_iommu:
+	if (pgtbl_ops)
+		free_io_pgtable_ops(pgtbl_ops);
 	qcom_domain->iommu = NULL;
 out_unlock:
 	mutex_unlock(&qcom_domain->init_mutex);
@@ -1001,8 +1048,13 @@ static int __maybe_unused qcom_iommu_resume(struct device *dev)
 		for (i = 0; i <= qcom_iommu->max_asid; i++) {
 			struct qcom_iommu_ctx *ctx = qcom_iommu->ctxs[i];
 
-			if (ctx && ctx->domain && !ctx->secured_ctx)
-				qcom_iommu_program_ctx(qcom_iommu, ctx);
+			if (ctx && ctx->domain && !ctx->secured_ctx) {
+				ret = qcom_iommu_program_ctx(qcom_iommu, ctx);
+				if (ret) {
+					clk_bulk_disable_unprepare(CLK_NUM, qcom_iommu->clks);
+					return ret;
+				}
+			}
 		}
 		/* Finish context programming before the master resumes. */
 		wmb();
