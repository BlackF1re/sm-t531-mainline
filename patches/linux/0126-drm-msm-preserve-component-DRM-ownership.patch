From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Subject: [PATCH] drm/msm: keep DRM and Adreno platform data distinct during teardown

msm_gpu_init stores adreno_smmu_priv in the GPU platform drvdata. It is
not msm_drm_private and may be NULL before a component binds. Pass the DRM
device as component data in both modes, retain it through teardown, and
select removal using the same immutable mode as probe. This fixes invalid
casts on failure/unbind without changing DMA synchronization or mappings.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -66,11 +66,11 @@
 	return separate_gpu_kms;
 }
 
-static int msm_drm_uninit(struct device *dev, const struct component_ops *gpu_ops)
-{
-	struct platform_device *pdev = to_platform_device(dev);
-	struct msm_drm_private *priv = platform_get_drvdata(pdev);
-	struct drm_device *ddev = priv->dev;
+static int msm_drm_uninit(struct drm_device *ddev,
+			  const struct component_ops *gpu_ops)
+{
+	struct device *dev = ddev->dev;
+	struct msm_drm_private *priv = ddev->dev_private;
 
 	/*
 	 * Shutdown the hw if we're far enough along where things might be on.
@@ -93,7 +93,7 @@
 		msm_drm_kms_uninit(dev);
 
 	if (gpu_ops)
-		gpu_ops->unbind(dev, dev, NULL);
+		gpu_ops->unbind(dev, dev, ddev);
 	else
 		component_unbind_all(dev, ddev);
 
@@ -152,7 +152,7 @@
 
 	/* Bind all our sub-components: */
 	if (gpu_ops)
-		ret = gpu_ops->bind(dev, dev, NULL);
+		ret = gpu_ops->bind(dev, dev, ddev);
 	else
 		ret = component_bind_all(dev, ddev);
 	if (ret)
@@ -182,7 +182,7 @@
 	return 0;
 
 err_msm_uninit:
-	msm_drm_uninit(dev, gpu_ops);
+	msm_drm_uninit(ddev, gpu_ops);
 
 	return ret;
 
@@ -1044,7 +1044,9 @@
 
 static void msm_drm_unbind(struct device *dev)
 {
-	msm_drm_uninit(dev, NULL);
+	struct msm_drm_private *priv = dev_get_drvdata(dev);
+
+	msm_drm_uninit(priv->dev, NULL);
 }
 
 const struct component_master_ops msm_drm_ops = {
@@ -1120,7 +1122,9 @@
 void msm_gpu_remove(struct platform_device *pdev,
 		    const struct component_ops *ops)
 {
-	msm_drm_uninit(&pdev->dev, ops);
+	struct msm_gpu *gpu = dev_to_gpu(&pdev->dev);
+
+	msm_drm_uninit(gpu->dev, ops);
 }
 
 static int __init msm_drm_register(void)
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -211,8 +211,8 @@
 {
 	static struct adreno_platform_config config = {};
 	const struct adreno_info *info;
-	struct msm_drm_private *priv = dev_get_drvdata(master);
-	struct drm_device *drm = priv->dev;
+	struct drm_device *drm = data;
+	struct msm_drm_private *priv = drm->dev_private;
 	struct msm_gpu *gpu;
 	int ret;
 
@@ -254,7 +254,8 @@
 static void adreno_unbind(struct device *dev, struct device *master,
 		void *data)
 {
-	struct msm_drm_private *priv = dev_get_drvdata(master);
+	struct drm_device *drm = data;
+	struct msm_drm_private *priv = drm->dev_private;
 	struct msm_gpu *gpu = dev_to_gpu(dev);
 
 	if (pm_runtime_enabled(dev))
@@ -269,10 +270,15 @@
 	.unbind = adreno_unbind,
 };
 
+static bool adreno_uses_components(struct platform_device *pdev)
+{
+	return !of_device_is_compatible(pdev->dev.of_node, "amd,imageon") &&
+	       !msm_gpu_no_components();
+}
+
 static int adreno_probe(struct platform_device *pdev)
 {
-	if (of_device_is_compatible(pdev->dev.of_node, "amd,imageon") ||
-	    msm_gpu_no_components())
+	if (!adreno_uses_components(pdev))
 		return msm_gpu_probe(pdev, &a3xx_ops);
 
 	return component_add(&pdev->dev, &a3xx_ops);
@@ -280,9 +286,7 @@
 
 static void adreno_remove(struct platform_device *pdev)
 {
-	struct msm_drm_private *priv = platform_get_drvdata(pdev);
-
-	if (priv->kms_init)
+	if (adreno_uses_components(pdev))
 		component_del(&pdev->dev, &a3xx_ops);
 	else
 		msm_gpu_remove(pdev, &a3xx_ops);
