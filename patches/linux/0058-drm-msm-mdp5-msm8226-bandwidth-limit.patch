From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Wed, 14 Oct 2026 12:00:00 +0700
Subject: [PATCH] drm/msm/mdp5: limit MSM8226 vote to its factory bandwidth

The generic static 6.4 GB/s MDP vote asks for 800 MHz DDR on MSM8226,
above the documented 533 MHz factory plan. Restrict the conservative
bring-up vote to 4.256 GB/s on this SoC and propagate bandwidth failures.
The existing static lifetime vote remains; dynamic scanout bandwidth and
power optimization are explicitly unfinished, not production validation.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c b/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c
index 3934cd060..26d9ffecd 100644
--- a/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c
+++ b/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c
@@ -782,6 +782,8 @@ static int mdp5_setup_interconnect(struct platform_device *pdev)
 	struct icc_path *path0 = msm_icc_get(&pdev->dev, "mdp0-mem");
 	struct icc_path *path1 = msm_icc_get(&pdev->dev, "mdp1-mem");
 	struct icc_path *path_rot = msm_icc_get(&pdev->dev, "rotator-mem");
+	u32 peak = MBps_to_icc(6400);
+	int ret;
 
 	if (IS_ERR(path0))
 		return PTR_ERR(path0);
@@ -797,12 +799,20 @@ static int mdp5_setup_interconnect(struct platform_device *pdev)
 		return 0;
 	}
 
-	icc_set_bw(path0, 0, MBps_to_icc(6400));
+	/* Conservative SoC maximum, matching the factory 533 MHz DDR plan. */
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,msm8226-mdp5"))
+		peak = 4256000;
 
-	if (!IS_ERR_OR_NULL(path1))
-		icc_set_bw(path1, 0, MBps_to_icc(6400));
+	ret = icc_set_bw(path0, 0, peak);
+	if (ret)
+		return ret;
+	if (!IS_ERR_OR_NULL(path1)) {
+		ret = icc_set_bw(path1, 0, peak);
+		if (ret)
+			return ret;
+	}
 	if (!IS_ERR_OR_NULL(path_rot))
-		icc_set_bw(path_rot, 0, MBps_to_icc(6400));
+		return icc_set_bw(path_rot, 0, peak);
 
 	return 0;
 }
