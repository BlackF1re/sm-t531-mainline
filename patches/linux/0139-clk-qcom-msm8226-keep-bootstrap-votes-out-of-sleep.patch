From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Subject: [PATCH] clk: qcom: avoid MSM8226 bootstrap clock votes in sleep

Keep active bootstrap votes until consumers take ownership, but do not
copy their maximum rates into the MSM8226 RPM sleep context. Explicit
consumer prepare/unprepare voting remains unchanged. Other SoCs retain
the existing handoff.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/clk/qcom/clk-smd-rpm.c b/drivers/clk/qcom/clk-smd-rpm.c
index 103db984a..769d76afb 100644
--- a/drivers/clk/qcom/clk-smd-rpm.c
+++ b/drivers/clk/qcom/clk-smd-rpm.c
@@ -187,7 +187,7 @@ struct rpm_smd_clk_desc {
 
 static DEFINE_MUTEX(rpm_smd_clk_lock);
 
-static int clk_smd_rpm_handoff(const struct clk_smd_rpm *r)
+static int clk_smd_rpm_handoff(const struct clk_smd_rpm *r, bool active_only)
 {
 	int ret;
 	struct clk_smd_rpm_req req = {
@@ -201,6 +201,12 @@ static int clk_smd_rpm_handoff(const struct clk_smd_rpm *r)
 				 sizeof(req));
 	if (ret)
 		return ret;
+	/* Bootstrap clocks must not keep the MSM8226 sleep context active.
+	 * Keep the active handoff until the real consumers take ownership.
+	 */
+	if (active_only)
+		req.value = 0;
+
 	ret = qcom_rpm_smd_write(rpmcc_smd_rpm, QCOM_SMD_RPM_SLEEP_STATE,
 				 r->rpm_res_type, r->rpm_clk_id, &req,
 				 sizeof(req));
@@ -1344,6 +1350,7 @@ static int rpm_smd_clk_probe(struct platform_device *pdev)
 	struct clk_smd_rpm **rpm_smd_clks;
 	const struct rpm_smd_clk_desc *desc;
 	struct platform_device *icc_pdev;
+	bool active_only;
 
 	rpmcc_smd_rpm = dev_get_drvdata(pdev->dev.parent);
 	if (!rpmcc_smd_rpm) {
@@ -1355,6 +1362,8 @@ static int rpm_smd_clk_probe(struct platform_device *pdev)
 	if (!desc)
 		return -EINVAL;
 
+	active_only = of_device_is_compatible(pdev->dev.of_node,
+					     "qcom,rpmcc-msm8226");
 	rpm_smd_clks = desc->clks;
 	num_clks = desc->num_clks;
 
@@ -1368,7 +1377,7 @@ static int rpm_smd_clk_probe(struct platform_device *pdev)
 		if (!rpm_smd_clks[i])
 			continue;
 
-		ret = clk_smd_rpm_handoff(rpm_smd_clks[i]);
+		ret = clk_smd_rpm_handoff(rpm_smd_clks[i], active_only);
 		if (ret)
 			goto err;
 	}
@@ -1377,7 +1386,7 @@ static int rpm_smd_clk_probe(struct platform_device *pdev)
 		if (!desc->icc_clks[i])
 			continue;
 
-		ret = clk_smd_rpm_handoff(desc->icc_clks[i]);
+		ret = clk_smd_rpm_handoff(desc->icc_clks[i], active_only);
 		if (ret)
 			goto err;
 	}
