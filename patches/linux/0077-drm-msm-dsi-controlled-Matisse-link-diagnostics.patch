From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Wed, 14 Oct 2026 12:00:00 +0700
Subject: [PATCH] drm/msm/dsi: add controlled Matisse link diagnostics

The black-screen native test cannot yet distinguish missing MDP pixel
fetch from a stalled DSI command/video link. Provide an opt-in,
Matisse-only debugfs diagnostic in the owning host driver.

Writing1 enables the existing DSI test pattern generator;0 disables it;
2 performs the existing controller software reset, retaining CLK_CTRL.
Reject powered-off or disabled hosts. Serialize against modesets and
commands, hold runtime power, mask the peripheral interrupt source
and drain error work while changing the controller. This avoids raw external MMIO writes and
allows separate, observable link experiments without repeated reboots.

The file is absent by default and is not a production control interface.

The first live diagnostic used disable_irq(), but MDSS virtual IRQ
masking only updates a software bit and does not stop its asserted
peripheral source. That experiment hung the device. Mask the DSI
source before synchronization, prevent error work from re-enabling it
while diagnosis runs, and restore the source masks afterward.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
index 00c4600f1..94ca2c520 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -122,6 +122,8 @@ int dsi_calc_clk_rate_6g(struct msm_dsi_host *msm_host, bool is_bonded_dsi);
 void msm_dsi_host_snapshot(struct msm_disp_state *disp_state, struct mipi_dsi_host *host);
 void msm_dsi_host_test_pattern_en(struct mipi_dsi_host *host);
 void msm_dsi_host_start_deferred_video(struct mipi_dsi_host *host);
+void msm_dsi_host_debugfs_init(struct mipi_dsi_host *host,
+			       struct drm_minor *minor);
 struct drm_dsc_config *msm_dsi_host_get_dsc_config(struct mipi_dsi_host *host);
 bool msm_dsi_host_is_wide_bus_enabled(struct mipi_dsi_host *host);
 
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 936ce9abb..f28db30a1 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -5,6 +5,7 @@
 
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/debugfs.h>
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
 #include <linux/interrupt.h>
@@ -22,6 +23,8 @@
 
 #include <drm/display/drm_dsc_helper.h>
 #include <drm/drm_of.h>
+#include <drm/drm_modeset_lock.h>
+#include <drm/drm_file.h>
 
 #include "dsi.h"
 #include "dsi.xml.h"
@@ -47,6 +50,10 @@ module_param(matisse_defer_video, bool, 0400);
 MODULE_PARM_DESC(matisse_defer_video,
 		"Start Matisse video after downstream bridge pre_enable");
 
+static bool matisse_link_diag;
+module_param(matisse_link_diag, bool, 0400);
+MODULE_PARM_DESC(matisse_link_diag, "Expose controlled Matisse DSI link diagnostics");
+
 static int dsi_get_version(const void __iomem *base, u32 *major, u32 *minor)
 {
 	u32 ver;
@@ -158,6 +165,7 @@ struct msm_dsi_host {
 	spinlock_t intr_lock; /* Protect interrupt ctrl register */
 
 	u32 err_work_state;
+	bool link_diagnostic;
 	struct work_struct err_work;
 	struct workqueue_struct *workqueue;
 
@@ -760,6 +768,10 @@ static void dsi_intr_ctrl(struct msm_dsi_host *msm_host, u32 mask, int enable)
 	spin_lock_irqsave(&msm_host->intr_lock, flags);
 	intr = dsi_read(msm_host, REG_DSI_INTR_CTRL);
 
+	/* Error work must not unmask the source during a live diagnostic. */
+	if (mask == DSI_IRQ_MASK_ERROR && READ_ONCE(msm_host->link_diagnostic))
+		enable = 0;
+
 	if (enable)
 		intr |= mask;
 	else
@@ -2766,6 +2778,74 @@ void msm_dsi_host_test_pattern_en(struct mipi_dsi_host *host)
 				DSI_TEST_PATTERN_GEN_CMD_STREAM0_TRIGGER_SW_TRIGGER);
 }
 
+static int matisse_link_diag_set(void *data, u64 command)
+{
+	struct msm_dsi_host *msm_host = data;
+	u32 clocks, pattern, irq_masks;
+	const u32 all_irq_masks = DSI_IRQ_MASK_CMD_DMA_DONE |
+		DSI_IRQ_MASK_CMD_MDP_DONE | DSI_IRQ_MASK_VIDEO_DONE |
+		DSI_IRQ_MASK_BTA_DONE | DSI_IRQ_MASK_ERROR;
+	int ret = 0;
+
+	if (command > 2)
+		return -EINVAL;
+
+	drm_modeset_lock_all(msm_host->dev);
+	mutex_lock(&msm_host->dev_mutex);
+	mutex_lock(&msm_host->cmd_mutex);
+	if (!msm_host->matisse || !msm_host->power_on || !msm_host->enabled) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+
+	ret = pm_runtime_resume_and_get(&msm_host->pdev->dev);
+	if (ret < 0)
+		goto unlock;
+
+	/* MDSS's virtual IRQ mask does not mask the peripheral source. */
+	WRITE_ONCE(msm_host->link_diagnostic, true);
+	irq_masks = (dsi_read(msm_host, REG_DSI_INTR_CTRL) & all_irq_masks) |
+		    DSI_IRQ_MASK_ERROR;
+	dsi_intr_ctrl(msm_host, all_irq_masks, 0);
+	synchronize_irq(msm_host->irq);
+	cancel_work_sync(&msm_host->err_work);
+	if (command == 2) {
+		clocks = dsi_read(msm_host, REG_DSI_CLK_CTRL);
+		dsi_sw_reset(msm_host);
+		dsi_write(msm_host, REG_DSI_CLK_CTRL, clocks);
+	} else if (command == 1) {
+		msm_dsi_host_test_pattern_en(&msm_host->base);
+	} else {
+		pattern = dsi_read(msm_host, REG_DSI_TEST_PATTERN_GEN_CTRL);
+		dsi_write(msm_host, REG_DSI_TEST_PATTERN_GEN_CTRL,
+			  pattern & ~DSI_TEST_PATTERN_GEN_CTRL_EN);
+	}
+	msm_host->err_work_state = 0;
+	WRITE_ONCE(msm_host->link_diagnostic, false);
+	dsi_intr_ctrl(msm_host, irq_masks, 1);
+	pm_runtime_put(&msm_host->pdev->dev);
+	ret = 0;
+unlock:
+	mutex_unlock(&msm_host->cmd_mutex);
+	mutex_unlock(&msm_host->dev_mutex);
+	drm_modeset_unlock_all(msm_host->dev);
+	return ret;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(matisse_link_diag_fops, NULL,
+			 matisse_link_diag_set, "%llu\n");
+
+void msm_dsi_host_debugfs_init(struct mipi_dsi_host *host,
+			       struct drm_minor *minor)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+
+	if (matisse_link_diag && msm_host->matisse)
+		debugfs_create_file("matisse_dsi_link", 0200,
+				    minor->debugfs_root, msm_host,
+				    &matisse_link_diag_fops);
+}
+
 struct drm_dsc_config *msm_dsi_host_get_dsc_config(struct mipi_dsi_host *host)
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
diff --git a/drivers/gpu/drm/msm/msm_debugfs.c b/drivers/gpu/drm/msm/msm_debugfs.c
index f12701e28..43f083baf 100644
--- a/drivers/gpu/drm/msm/msm_debugfs.c
+++ b/drivers/gpu/drm/msm/msm_debugfs.c
@@ -19,6 +19,7 @@
 #include "msm_kms.h"
 #include "msm_debugfs.h"
 #include "disp/msm_disp_snapshot.h"
+#include "dsi/dsi.h"
 
 /*
  * GPU Snapshot:
@@ -224,6 +225,13 @@ static void msm_debugfs_kms_init(struct drm_minor *minor)
 	if (priv->kms->funcs->debugfs_init)
 		priv->kms->funcs->debugfs_init(priv->kms, minor);
 
+	if (IS_ENABLED(CONFIG_DRM_MSM_DSI)) {
+		for (int i = 0; i < ARRAY_SIZE(priv->kms->dsi); i++) {
+			if (priv->kms->dsi[i])
+				msm_dsi_host_debugfs_init(priv->kms->dsi[i]->host,
+							  minor);
+		}
+	}
 }
 #else /* ! CONFIG_DRM_MSM_KMS */
 static void msm_debugfs_kms_init(struct drm_minor *minor)
