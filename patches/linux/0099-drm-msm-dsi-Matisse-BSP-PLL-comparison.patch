From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Wed, 14 Oct 2026 12:00:00 +0700
Subject: [PATCH] drm: msm: dsi: add Matisse BSP PLL comparison

Extend the existing off-by-default Matisse PHY comparison with a
separate BSP PLL bit. The exact Samsung clock-mdss-8974.c::vco_set_rate()
used by dsi_vco_clk_8226 programs CAL_CFG4=0x66 and VCOLPF_CFG=0x71,
and builds SDM_CFG1 from the DC offset without preserving DITHER_EN.
The current generic provider uses 0x06/0x31 and preserves the reset
dither bit. The accepted working firmware snapshot has dither clear.

Keep the requested PLL frequency, dividers and the common clock code
unchanged. Only the matching Matisse/MSM8226 diagnostic profile applies
these three BSP control differences. Bit4 can be combined with timing
and regulator comparisons using profile7; default0 retains existing
behavior. This is a controlled factory-configuration experiment, not
a claimed video fix or a memory-frequency change.

Link: https://github.com/LineageOS/android_kernel_samsung_msm8226/blob/3fa1853ed5d6c3a8ef5a2fda9822705243bbc256/arch/arm/mach-msm/clock-mdss-8974.c

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_28nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_28nm.c
index f0c706af8..626bf962f 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_28nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_28nm.c
@@ -42,18 +42,18 @@
 #define DSI_PHY_28NM_QUIRK_PHY_LP	BIT(0)
 #define DSI_PHY_28NM_QUIRK_PHY_8226	BIT(1)
 
-/* Temporary Matisse profile: bit0 timing, bit1 internal regulator controls. */
+/* Temporary Matisse profile: bit0 timing, bit1 regulator, bit2 BSP PLL. */
 static unsigned int matisse_phy_profile;
 module_param(matisse_phy_profile, uint, 0600);
 MODULE_PARM_DESC(matisse_phy_profile,
-		 "Matisse diagnostic: 1 firmware timing, 2 regulator, 3 both");
+		 "Matisse diagnostic bits: 1 firmware timing, 2 regulator, 4 BSP PLL");
 
 static unsigned int dsi_28nm_matisse_profile(struct msm_dsi_phy *phy)
 {
 	if (!(phy->cfg->quirks & DSI_PHY_28NM_QUIRK_PHY_8226) ||
 	    !of_machine_is_compatible("samsung,matisse3g"))
 		return 0;
-	return matisse_phy_profile & 3;
+	return matisse_phy_profile & 7;
 }
 
 #define LPFR_LUT_SIZE			10
@@ -136,6 +136,7 @@ static int dsi_pll_28nm_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 	struct dsi_pll_28nm *pll_28nm = to_pll_28nm(hw);
 	struct device *dev = &pll_28nm->phy->pdev->dev;
 	void __iomem *base = pll_28nm->phy->pll_base;
+	bool factory_pll = dsi_28nm_matisse_profile(pll_28nm->phy) & 4;
 	unsigned long div_fbx1000, gen_vco_clk;
 	u32 refclk_cfg, frac_n_mode, frac_n_value;
 	u32 sdm_cfg0, sdm_cfg1, sdm_cfg2, sdm_cfg3;
@@ -188,6 +189,9 @@ static int dsi_pll_28nm_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 	rem = 0;
 	sdm_cfg1 = readl(base + REG_DSI_28nm_PHY_PLL_SDM_CFG1);
 	sdm_cfg1 &= ~DSI_28nm_PHY_PLL_SDM_CFG1_DC_OFFSET__MASK;
+	/* BSP set_rate builds SDM_CFG1 from the DC offset, leaving dither off. */
+	if (factory_pll)
+		sdm_cfg1 &= ~DSI_28nm_PHY_PLL_SDM_CFG1_DITHER_EN__MASK;
 	if (frac_n_mode) {
 		sdm_cfg0 = 0x0;
 		sdm_cfg0 |= DSI_28nm_PHY_PLL_SDM_CFG0_BYP_DIV(0);
@@ -215,7 +219,8 @@ static int dsi_pll_28nm_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 
 	writel(0x02, base + REG_DSI_28nm_PHY_PLL_CHGPUMP_CFG);
 	writel(0x2b, base + REG_DSI_28nm_PHY_PLL_CAL_CFG3);
-	writel(0x06, base + REG_DSI_28nm_PHY_PLL_CAL_CFG4);
+	writel(factory_pll ? 0x66 : 0x06,
+	       base + REG_DSI_28nm_PHY_PLL_CAL_CFG4);
 	writel(0x0d, base + REG_DSI_28nm_PHY_PLL_LKDET_CFG2);
 
 	writel(sdm_cfg1, base + REG_DSI_28nm_PHY_PLL_SDM_CFG1);
@@ -233,7 +238,8 @@ static int dsi_pll_28nm_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 
 	writel(refclk_cfg, base + REG_DSI_28nm_PHY_PLL_REFCLK_CFG);
 	writel(0x00, base + REG_DSI_28nm_PHY_PLL_PWRGEN_CFG);
-	writel(0x31, base + REG_DSI_28nm_PHY_PLL_VCOLPF_CFG);
+	writel(factory_pll ? 0x71 : 0x31,
+	       base + REG_DSI_28nm_PHY_PLL_VCOLPF_CFG);
 	writel(sdm_cfg0, base + REG_DSI_28nm_PHY_PLL_SDM_CFG0);
 	writel(0x12, base + REG_DSI_28nm_PHY_PLL_CAL_CFG0);
 	writel(0x30, base + REG_DSI_28nm_PHY_PLL_CAL_CFG6);
