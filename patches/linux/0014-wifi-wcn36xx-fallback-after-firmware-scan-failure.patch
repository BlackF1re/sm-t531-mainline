From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Mon, 12 Oct 2026 12:00:00 +0700
Subject: [PATCH] wifi: wcn36xx: fall back after firmware scan failure

SM-T531 firmware API 1.5.1.2 advertises scan offload but times out on
update-channel-list and start-scan-offload requests. The pending scan
remains set and subsequent scans fail with EBUSY.

Check both command results, release the pending request on failure and
use the existing mac80211 scan path for this session. Do not hard-code
a firmware version or replace radio functionality.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
--- a/drivers/net/wireless/ath/wcn36xx/main.c
+++ b/drivers/net/wireless/ath/wcn36xx/main.c
@@ -631,6 +631,7 @@
 			   struct ieee80211_scan_request *hw_req)
 {
 	struct wcn36xx *wcn = hw->priv;
+	int ret;
 
 	if (!wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, SCAN_OFFLOAD)) {
 		/* fallback to mac80211 software scan */
@@ -657,8 +658,18 @@
 
 	mutex_unlock(&wcn->scan_lock);
 
-	wcn36xx_smd_update_channel_list(wcn, &hw_req->req);
-	return wcn36xx_smd_start_hw_scan(wcn, vif, &hw_req->req);
+	ret = wcn36xx_smd_update_channel_list(wcn, &hw_req->req);
+	if (!ret)
+		ret = wcn36xx_smd_start_hw_scan(wcn, vif, &hw_req->req);
+	if (!ret)
+		return 0;
+
+	mutex_lock(&wcn->scan_lock);
+	wcn->scan_req = NULL;
+	mutex_unlock(&wcn->scan_lock);
+	wcn36xx_firmware_clear_feat_caps(wcn->fw_feat_caps, SCAN_OFFLOAD);
+	wcn36xx_warn("Firmware scan unavailable (%d), using software scan\n", ret);
+	return 1;
 }
 
 static void wcn36xx_cancel_hw_scan(struct ieee80211_hw *hw,
