+					 &bms->gain_den, IIO_CHAN_INFO_CALIBSCALE);
+	if (ret < 0)
+		return ret;
+	if (ret != IIO_VAL_FRACTIONAL || bms->gain_num <= 0 || bms->gain_den <= 0)
+		return -ERANGE;
+
 	cfg.drv_data = bms;
 	cfg.fwnode = dev_fwnode(dev);
 	bms->battery = devm_power_supply_register(dev, &pm8226_bms_desc, &cfg);
@@ -216,5 +392,5 @@
 	},
 };
