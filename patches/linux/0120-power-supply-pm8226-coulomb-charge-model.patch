 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -15,9 +21,20 @@
 
 #define PM8226_BMS_TYPE		0x04
 #define PM8226_BMS_SUBTYPE	0x05
+#define PM8226_BMS_HOLD		0x42
+#define PM8226_BMS_HOLD_DATA	BIT(0)
+#define PM8226_BMS_CC		0x8a
 #define PM8226_BMS_OCV		0x90
+#define PM8226_BMS_VSENSE	0x98
 #define PM8226_BAT_PRESENT	BIT(7)
 #define PM8226_BMS_POLL_INTERVAL	(30 * HZ)
+
+struct pm8226_bms_sample {
+	int ocv_uv;
+	int current_ua;
+	int charge_uah;
+	int capacity;
+};
 
 struct pm8226_bms {
 	struct regmap *regmap;
@@ -26,6 +43,18 @@
 	struct iio_channel *ref625;
 	struct iio_channel *ref1250;
 	struct iio_channel *temperature;
+	struct iio_channel *current_adc;
+	struct mutex lock;
+	struct pm8226_bms_sample sample;
+	unsigned long sample_expires;
+	u32 rsense_uohm;
+	int gain_num;
+	int gain_den;
+	u16 last_ocv_raw;
+	int last_ocv_temp;
+	s64 last_cc_raw;
+	s64 accumulated_cc;
+	bool cc_valid;
 	struct delayed_work work;
 	u32 base;
 	u32 present_reg;
@@ -53,13 +82,135 @@
