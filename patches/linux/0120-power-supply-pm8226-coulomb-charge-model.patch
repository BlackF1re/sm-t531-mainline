 }
 
+/* The BMS integrates signed sense voltage; positive is discharge. */
+static s64 pm8226_bms_cc_to_uah(struct pm8226_bms *bms, s64 raw)
+{
+	s64 uv, pvh;
+
+	uv = div_s64(raw * 542535, 100000);
+	uv = div_s64(uv * bms->gain_num, bms->gain_den);
+	/* Divide before the last factor of 10 to avoid overflowing at 36 bits. */
+	pvh = div_s64(uv * 56 * 100000, 32764 * 3600) * 10;
+	return div_s64(pvh, bms->rsense_uohm);
+}
+
+static int pm8226_bms_snapshot(struct pm8226_bms *bms, u16 *ocv,
+			      s64 *cc, s16 *vsense)
+{
+	unsigned int saved;
+	u8 data[5];
+	u64 raw = 0;
+	int ret, restore, i;
+
+	ret = regmap_read(bms->regmap, bms->base + PM8226_BMS_HOLD, &saved);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(bms->regmap, bms->base + PM8226_BMS_HOLD,
+				 PM8226_BMS_HOLD_DATA, PM8226_BMS_HOLD_DATA);
+	if (ret)
+		goto restore;
+	/* BSP requires at least two sleep-clock cycles before reading. */
+	usleep_range(100, 200);
+	ret = regmap_bulk_read(bms->regmap, bms->base + PM8226_BMS_OCV, data, 2);
+	if (ret)
+		goto restore;
+	*ocv = data[0] | data[1] << 8;
+	ret = regmap_bulk_read(bms->regmap, bms->base + PM8226_BMS_CC, data, 5);
+	if (ret)
+		goto restore;
+	for (i = 0; i < 5; i++)
+		raw |= (u64)data[i] << (i * 8);
+	*cc = sign_extend64(raw, 35);
+	ret = regmap_bulk_read(bms->regmap, bms->base + PM8226_BMS_VSENSE, data, 2);
+	if (!ret)
+		*vsense = data[0] | data[1] << 8;
+restore:
+	/* Restore the prior hold state even after a failed hold or sample read. */
+	restore = regmap_update_bits(bms->regmap, bms->base + PM8226_BMS_HOLD,
+				     PM8226_BMS_HOLD_DATA, saved & PM8226_BMS_HOLD_DATA);
+	return ret ? ret : restore;
+}
+
+static int pm8226_bms_sample(struct pm8226_bms *bms,
+			    struct power_supply *psy,
+			    struct pm8226_bms_sample *sample)
+{
+	struct power_supply_battery_info *info = psy->battery_info;
+	s64 cc, total, current_ua, charge;
+	u16 ocv;
+	s16 vsense;
+	int ret, temp, capacity, ocv_uv;
+
+	mutex_lock(&bms->lock);
+	if (bms->cc_valid && time_before(jiffies, bms->sample_expires)) {
+		*sample = bms->sample;
+		ret = 0;
+		goto out;
+	}
+	ret = pm8226_bms_snapshot(bms, &ocv, &cc, &vsense);
+	if (ret)
+		goto out;
+	if (ocv <= 0x6000 || ocv == 0xffff) {
+		ret = -ENODATA;
+		goto out;
+	}
+	ret = pm8226_bms_raw_to_uv(bms, ocv, &ocv_uv);
+	if (ret)
+		goto out;
+	ret = iio_read_channel_processed(bms->temperature, &temp);
+	if (ret < 0)
+		goto out;
+	temp = DIV_ROUND_CLOSEST(temp, 1000);
+	if (!info || info->charge_full_design_uah <= 0) {
+		ret = -ENODATA;
+		goto out;
+	}
+	/* The main counter resets when hardware accepts a new OCV. */
+	if (!bms->cc_valid || bms->last_ocv_raw != ocv) {
+		total = cc;
+	} else {
+		/* Track the signed 36-bit wrap without resetting the hardware. */
+		total = bms->accumulated_cc + sign_extend64(cc - bms->last_cc_raw, 35);
+		temp = bms->last_ocv_temp;
+	}
+	capacity = power_supply_batinfo_ocv2cap(info, ocv_uv, temp);
+	if (capacity < 0) {
+		ret = capacity;
+		goto out;
+	}
+	charge = div_s64((s64)info->charge_full_design_uah * capacity, 100);
+	charge -= pm8226_bms_cc_to_uah(bms, total);
+	charge = clamp_t(s64, charge, 0, info->charge_full_design_uah);
+	current_ua = div_s64((s64)vsense * 542535, 100000);
+	current_ua = div_s64(current_ua * bms->gain_num, bms->gain_den);
+	current_ua = div_s64(current_ua * 1000000, bms->rsense_uohm);
+
+	bms->sample.ocv_uv = ocv_uv;
+	/* power_supply current is positive when charging. */
+	bms->sample.current_ua = -current_ua;
+	bms->sample.charge_uah = charge;
+	bms->sample.capacity = DIV_ROUND_CLOSEST_ULL(charge * 100,
+						 info->charge_full_design_uah);
+	bms->last_ocv_raw = ocv;
+	bms->last_ocv_temp = temp;
+	bms->last_cc_raw = cc;
+	bms->accumulated_cc = total;
+	bms->cc_valid = true;
+	bms->sample_expires = jiffies + 2 * HZ;
+	*sample = bms->sample;
+	ret = 0;
+out:
+	mutex_unlock(&bms->lock);
+	return ret;
+}
