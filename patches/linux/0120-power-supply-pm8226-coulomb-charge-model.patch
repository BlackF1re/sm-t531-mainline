-		ret = regmap_bulk_read(bms->regmap, bms->base + PM8226_BMS_OCV,
-				       ocv, sizeof(ocv));
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = pm8226_bms_sample(bms, psy, &sample);
 		if (ret)
