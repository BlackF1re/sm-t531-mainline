 	ret = of_property_read_u32_index(dev->of_node, "reg", 0, &bms->base);
 	if (ret)
 		return ret;
@@ -187,6 +353,16 @@
 	if (IS_ERR(bms->temperature))
 		return dev_err_probe(dev, PTR_ERR(bms->temperature), "No thermistor\n");
 
+	bms->current_adc = devm_iio_channel_get(dev, "current");
+	if (IS_ERR(bms->current_adc))
+		return dev_err_probe(dev, PTR_ERR(bms->current_adc), "No current ADC\n");
