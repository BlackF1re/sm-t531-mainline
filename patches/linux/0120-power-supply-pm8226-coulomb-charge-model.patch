+		else if (prop == POWER_SUPPLY_PROP_CHARGE_NOW)
+			val->intval = sample.charge_uah;
+		else
+			val->intval = sample.capacity;
+		return 0;
 	case POWER_SUPPLY_PROP_TEMP:
 		ret = iio_read_channel_processed(bms->temperature, &raw);
 		if (ret < 0)
@@ -116,6 +274,9 @@
