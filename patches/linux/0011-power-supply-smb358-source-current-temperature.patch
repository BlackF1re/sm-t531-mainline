+			return ret;
+		schedule_work(&smb->source_work);
+	}
 
 	usb_rdev_cfg.dev = dev;
 	usb_rdev_cfg.driver_data = smb;
@@ -1591,6 +1867,9 @@
 		smb347_irq_disable(smb);
 		return PTR_ERR(smb->usb_rdev);
 	}
+
+	if (smb->temperature_channel)
+		schedule_delayed_work(&smb->temperature_work, 0);
 
 	return 0;
 }
