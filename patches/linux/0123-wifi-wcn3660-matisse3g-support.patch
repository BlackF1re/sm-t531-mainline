+#define WCN36XX_MON_DPU_ERROR_IRQ	0xfb081820
+
+/* Commands 7/8 in the tested WCN3660 firmware's HAL dump table. */
+static int wcn36xx_smd_rxp_reg(struct wcn36xx *wcn, u32 addr, u32 *value,
+			       bool write)
+{
+	struct wcn36xx_hal_dump_cmd_req_msg req;
+	struct wcn36xx_hal_dump_cmd_rsp_msg *rsp;
+	int ret;
+
+	if (addr != WCN36XX_MON_RXP_CFG && addr != WCN36XX_MON_RXP_TYPES_LO &&
+	    addr != WCN36XX_MON_RXP_TYPES_HI && addr != WCN36XX_MON_DPU_ERROR_WQ &&
+	    addr != WCN36XX_MON_DPU_ERROR_IRQ)
+		return -EINVAL;
+	mutex_lock(&wcn->hal_mutex);
+	INIT_HAL_MSG(req, WCN36XX_HAL_DUMP_COMMAND_REQ);
+	req.arg1 = write ? 8 : 7;
+	req.arg2 = addr;
+	req.arg3 = write ? *value : 0;
+	req.arg4 = 0;
+	req.arg5 = 0;
+	PREPARE_HAL_BUF(wcn->hal_buf, req);
+	ret = wcn36xx_smd_send_and_wait(wcn, req.header.len);
+	if (ret)
+		goto out;
+	rsp = (void *)wcn->hal_buf;
+	if (wcn->hal_rsp_len < offsetof(typeof(*rsp), rsp_buffer) ||
+	    rsp->header.msg_type != WCN36XX_HAL_DUMP_COMMAND_RSP || rsp->status) {
+		ret = -EPROTO;
+		goto out;
+	}
+	if (!write) {
+		if (rsp->rsp_length != sizeof(*value) ||
+		    wcn->hal_rsp_len < offsetof(typeof(*rsp), rsp_buffer) + sizeof(*value)) {
+			ret = -EPROTO;
+			goto out;
+		}
+		memcpy(value, rsp->rsp_buffer, sizeof(*value));
+	}
+out:
+	mutex_unlock(&wcn->hal_mutex);
+	return ret;
+}
+
+static int wcn36xx_smd_rxp_write(struct wcn36xx *wcn, u32 addr, u32 value)
+{
+	u32 actual;
+	int ret;
+
+	ret = wcn36xx_smd_rxp_reg(wcn, addr, &value, true);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_reg(wcn, addr, &actual, false);
+	if (ret)
+		return ret;
+	return actual == value ? 0 : -EIO;
+}
+
+int wcn36xx_smd_monitor_filter(struct wcn36xx *wcn, bool enable)
+{
+	u32 error_wq;
+	int ret, err;
+
+	/* Register layout/commands are proven only on this stock firmware. */
+	if (!wcn36xx_is_legacy_wcn3660(wcn))
+		return -EOPNOTSUPP;
+	if (!enable) {
+		if (!wcn->monitor_filter_saved)
+			return 0;
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_CFG, wcn->monitor_rxp_cfg);
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_LO, wcn->monitor_rxp_lo);
+		if (!ret)
+			ret = err;
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_HI, wcn->monitor_rxp_hi);
+		if (!ret)
+			ret = err;
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_WQ,
+					    wcn->monitor_dpu_error_wq);
+		if (!ret)
+			ret = err;
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_IRQ,
+					    wcn->monitor_dpu_error_irq);
+		if (!ret)
+			ret = err;
+		if (!ret)
+			wcn->monitor_filter_saved = false;
+		return ret;
+	}
+	if (!wcn->monitor_filter_saved) {
+		ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_RXP_CFG, &wcn->monitor_rxp_cfg, false);
+		if (!ret)
+			ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_RXP_TYPES_LO,
+						  &wcn->monitor_rxp_lo, false);
+		if (!ret)
+			ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_RXP_TYPES_HI,
+						  &wcn->monitor_rxp_hi, false);
+		if (!ret)
+			ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_DPU_ERROR_WQ,
+						  &wcn->monitor_dpu_error_wq, false);
+		if (!ret)
+			ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_DPU_ERROR_IRQ,
+						  &wcn->monitor_dpu_error_irq, false);
+		if (ret)
+			return ret;
+		wcn->monitor_filter_saved = true;
+	}
+	/* Unknown-key frames otherwise go to firmware's DPU error queue (8).
+	 * In standalone monitor, DMA their original ciphertext to host RX (11).
+	 * Mask packet-error IRQs so firmware cannot race the host for those BDs;
+	 * retain fatal/MIC IRQs and all existing DPU packet-filter settings.
+	 */
+	ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_IRQ,
+				    wcn->monitor_dpu_error_irq & ~GENMASK(20, 0));
+	error_wq = (wcn->monitor_dpu_error_wq & ~0xff) | WCN36XX_DXE_WQ_RX_L;
+	if (!ret)
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_WQ, error_wq);
+	if (ret)
+		goto restore;
+	/* Keep RX enabled; bypass address lookup, unmask valid frame types. */
+	ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_CFG, wcn->monitor_rxp_cfg & ~BIT(2));
+	if (!ret)
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_LO, 0xffff0000);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_HI, 0);
+restore:
+	if (ret)
+		wcn36xx_smd_monitor_filter(wcn, false);
+	return ret;
+}
