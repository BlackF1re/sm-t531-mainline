+/* OF limits are per radio; do not modify the shared channel templates. */
+static int wcn36xx_of_freq_limits(struct wcn36xx *wcn)
+{
+	struct ieee80211_supported_band *band, *copy;
+	enum nl80211_band idx;
+	size_t size;
+
+	if (!of_property_present(wcn->dev->of_node, "ieee80211-freq-limit"))
+		return 0;
+
+	for (idx = 0; idx < NUM_NL80211_BANDS; idx++) {
+		band = wcn->hw->wiphy->bands[idx];
+		if (!band)
+			continue;
+		copy = devm_kmemdup(wcn->dev, band, sizeof(*band), GFP_KERNEL);
+		if (!copy)
+			return -ENOMEM;
+		size = array_size(band->n_channels, sizeof(*band->channels));
+		copy->channels = devm_kmemdup(wcn->dev, band->channels, size, GFP_KERNEL);
+		if (!copy->channels)
+			return -ENOMEM;
+		wcn->hw->wiphy->bands[idx] = copy;
+	}
+	wiphy_read_of_freq_limits(wcn->hw->wiphy);
+	return 0;
+}
