+/* A virtual monitor owns the radio only while no managed/AP vif is active. */
+static int wcn36xx_monitor_stop(struct wcn36xx *wcn)
+{
+	int ret;
+
+	if (!wcn->monitor_filter_saved)
+		return 0;
+	ret = wcn36xx_smd_monitor_filter(wcn, false);
+	if (!ret)
+		WRITE_ONCE(wcn->monitor_enabled, false);
+	return ret;
+}
+
+static int wcn36xx_monitor_channel(struct wcn36xx *wcn,
+				   struct ieee80211_vif *vif, int ch)
+{
+	int ret;
+
+	ret = wcn36xx_smd_switch_channel(wcn, vif, ch);
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+	/* RX can start as soon as the hardware filter is opened. */
+	WRITE_ONCE(wcn->monitor_enabled, true);
+	ret = wcn36xx_smd_monitor_filter(wcn, true);
+	if (ret && !wcn->monitor_filter_saved)
+		WRITE_ONCE(wcn->monitor_enabled, false);
+	return ret;
+}
