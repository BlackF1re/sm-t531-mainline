From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Tue, 13 Oct 2026 02:15:00 +0700
Subject: [PATCH] dt-bindings: cpufreq: qcom: describe MSM8226 fixed CPU OPPs

MSM8226 boards using conservative fixed CPU voltages still require the
Qualcomm cpufreq wrapper for RPM performance-domain votes. Select that
SoC and permit a generic OPP table as well as the existing specialized
efuse and CPR tables.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/Documentation/devicetree/bindings/cpufreq/qcom-cpufreq-nvmem.yaml b/Documentation/devicetree/bindings/cpufreq/qcom-cpufreq-nvmem.yaml
index 547265b8b..0ff371d55 100644
--- a/Documentation/devicetree/bindings/cpufreq/qcom-cpufreq-nvmem.yaml
+++ b/Documentation/devicetree/bindings/cpufreq/qcom-cpufreq-nvmem.yaml
@@ -32,6 +32,7 @@ select:
           - qcom,ipq8064
           - qcom,ipq8074
           - qcom,ipq9574
+          - qcom,msm8226
           - qcom,msm8909
           - qcom,msm8939
           - qcom,msm8960
@@ -60,6 +61,13 @@ patternProperties:
         then:
           $ref: /schemas/opp/opp-v2-qcom-level.yaml#
 
+      - if:
+          properties:
+            compatible:
+              const: operating-points-v2
+        then:
+          $ref: /schemas/opp/opp-v2.yaml#
+
     unevaluatedProperties: false
 
 allOf:
