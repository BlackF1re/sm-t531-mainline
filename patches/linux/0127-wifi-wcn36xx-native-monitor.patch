From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Subject: [PATCH] wifi: wcn36xx: receive raw data and control frames in monitor

The SM-T531 stock WCN3660 firmware does not reply to monitor HAL302.
A software monitor sees only firmware-filtered traffic. Readback and
firmware analysis identify the legacy RXP filters and DPU error queue:
unknown-key packets are sent to firmware queue 8 instead of host RX 11.

Give a standalone virtual monitor a valid self context, program its
channel/HT40 offset, bypass address/type filtering, mask packet-error
interrupts and direct the original DPU-error BDs to the host. Preserve
all existing DPU error filters, save/restore exact register values, and
verify writes. Restrict the register ABI to tested Pronto/WCN3660 firmware
1.5.1.2, CRM 12035159. Reject active mixed monitor/managed operation.

Initialize when the virtual vif is added, including the initial channel.
Do not treat captured ciphertext as decrypted or strip its IV metadata.
The normal managed/AP paths keep their existing decryption handling.

Tested on SM-T531: non-self probe responses, standalone management,
control, encrypted Data/QoS Data with extended IV, channel changes and
managed reconnection. See docs/WIFI.md for acceptance and remaining
limits (including firmware-controlled TX rates and bad-FCS reception).

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>

---
diff --git a/drivers/net/wireless/ath/wcn36xx/main.c b/drivers/net/wireless/ath/wcn36xx/main.c
--- a/drivers/net/wireless/ath/wcn36xx/main.c
+++ b/drivers/net/wireless/ath/wcn36xx/main.c
@@ -260,6 +260,8 @@
 
 	wcn36xx_debugfs_init(wcn);
 
+	WRITE_ONCE(wcn->monitor_enabled, false);
+	wcn->monitor_filter_saved = false;
 	INIT_LIST_HEAD(&wcn->vif_list);
 	spin_lock_init(&wcn->dxe_lock);
 	spin_lock_init(&wcn->survey_lock);
@@ -320,7 +322,39 @@
 	}
 }
 
-static void wcn36xx_change_opchannel(struct wcn36xx *wcn, int ch)
+/* A virtual monitor owns the radio only while no managed/AP vif is active. */
+static int wcn36xx_monitor_stop(struct wcn36xx *wcn)
+{
+	int ret;
+
+	if (!wcn->monitor_filter_saved)
+		return 0;
+	ret = wcn36xx_smd_monitor_filter(wcn, false);
+	if (!ret)
+		WRITE_ONCE(wcn->monitor_enabled, false);
+	return ret;
+}
+
+static int wcn36xx_monitor_channel(struct wcn36xx *wcn,
+				   struct ieee80211_vif *vif, int ch)
+{
+	int ret;
+
+	ret = wcn36xx_monitor_stop(wcn);
+	if (ret)
+		return ret;
+	ret = wcn36xx_smd_switch_channel(wcn, vif, ch);
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+	/* RX can start as soon as the hardware filter is opened. */
+	WRITE_ONCE(wcn->monitor_enabled, true);
+	ret = wcn36xx_smd_monitor_filter(wcn, true);
+	if (ret && !wcn->monitor_filter_saved)
+		WRITE_ONCE(wcn->monitor_enabled, false);
+	return ret;
+}
+
+static int wcn36xx_change_opchannel(struct wcn36xx *wcn, int ch)
 {
 	struct ieee80211_vif *vif = NULL;
 	struct wcn36xx_vif *tmp;
@@ -345,7 +379,7 @@
 
 	if (!channel) {
 		wcn36xx_err("Cannot tune to channel %d\n", ch);
-		return;
+		return -EINVAL;
 	}
 
 	spin_lock_irqsave(&wcn->survey_lock, flags);
@@ -355,10 +389,12 @@
 
 	list_for_each_entry(tmp, &wcn->vif_list, list) {
 		vif = wcn36xx_priv_to_vif(tmp);
+		if (vif->type == NL80211_IFTYPE_MONITOR)
+			return wcn36xx_monitor_channel(wcn, vif, ch);
 		wcn36xx_smd_switch_channel(wcn, vif, ch);
 	}
 
-	return;
+	return 0;
 }
 
 static int wcn36xx_config(struct ieee80211_hw *hw, int radio_idx, u32 changed)
@@ -406,7 +442,11 @@
 			}
 			wcn36xx_smd_start_scan(wcn, ch);
 		} else {
-			wcn36xx_change_opchannel(wcn, ch);
+			ret = wcn36xx_change_opchannel(wcn, ch);
+			if (ret) {
+				mutex_unlock(&wcn->conf_mutex);
+				return ret;
+			}
 		}
 	}
 
@@ -438,7 +478,8 @@
 
 	mutex_lock(&wcn->conf_mutex);
 
-	*total &= FIF_ALLMULTI;
+	*total &= FIF_ALLMULTI | (wcn->monitor_enabled ?
+		  FIF_BCN_PRBRESP_PROMISC | FIF_CONTROL | FIF_OTHER_BSS : 0);
 
 	fp = (void *)(unsigned long)multicast;
 	list_for_each_entry(tmp, &wcn->vif_list, list) {
@@ -1003,6 +1044,9 @@
 
 	mutex_lock(&wcn->conf_mutex);
 
+	if (vif->type == NL80211_IFTYPE_MONITOR &&
+	    wcn36xx_monitor_stop(wcn))
+		wcn36xx_warn("Failed to restore monitor receive path\n");
 	list_del(&vif_priv->list);
 	wcn36xx_smd_delete_sta_self(wcn, vif->addr);
 
@@ -1015,13 +1059,17 @@
 	struct wcn36xx *wcn = hw->priv;
 	struct wcn36xx_vif *vif_priv = wcn36xx_vif_to_priv(vif);
 
+	struct wcn36xx_vif *other;
+	int ret;
+
 	wcn36xx_dbg(WCN36XX_DBG_MAC, "mac add interface vif %p type %d\n",
 		    vif, vif->type);
 
-	if (!(NL80211_IFTYPE_STATION == vif->type ||
-	      NL80211_IFTYPE_AP == vif->type ||
-	      NL80211_IFTYPE_ADHOC == vif->type ||
-	      NL80211_IFTYPE_MESH_POINT == vif->type)) {
+	if (!(vif->type == NL80211_IFTYPE_STATION ||
+	      vif->type == NL80211_IFTYPE_AP ||
+	      vif->type == NL80211_IFTYPE_ADHOC ||
+	      vif->type == NL80211_IFTYPE_MESH_POINT ||
+	      vif->type == NL80211_IFTYPE_MONITOR)) {
 		wcn36xx_warn("Unsupported interface type requested: %d\n",
 			     vif->type);
 		return -EOPNOTSUPP;
@@ -1029,14 +1077,41 @@
 
 	mutex_lock(&wcn->conf_mutex);
 
+	/* Active mixed monitor/managed operation is not implemented. */
+	if (vif->type == NL80211_IFTYPE_MONITOR && !list_empty(&wcn->vif_list)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	list_for_each_entry(other, &wcn->vif_list, list) {
+		if (wcn36xx_priv_to_vif(other)->type == NL80211_IFTYPE_MONITOR) {
+			ret = -EBUSY;
+			goto out_unlock;
+		}
+	}
+	if (wcn->monitor_filter_saved) {
+		ret = wcn36xx_monitor_stop(wcn);
+		if (ret)
+			goto out_unlock;
+	}
+	/* The mac80211 virtual monitor has no netdev address. */
+	if (vif->type == NL80211_IFTYPE_MONITOR && is_zero_ether_addr(vif->addr))
+		ether_addr_copy(vif->addr, wcn->hw->wiphy->perm_addr);
 	vif_priv->bss_index = WCN36XX_HAL_BSS_INVALID_IDX;
 	INIT_LIST_HEAD(&vif_priv->sta_list);
 	list_add(&vif_priv->list, &wcn->vif_list);
-	wcn36xx_smd_add_sta_self(wcn, vif);
-
+	ret = wcn36xx_smd_add_sta_self(wcn, vif);
+	if (!ret && vif->type == NL80211_IFTYPE_MONITOR) {
+		ret = wcn36xx_monitor_channel(wcn, vif, WCN36XX_HW_CHANNEL(wcn));
+		if (ret)
+			wcn36xx_smd_delete_sta_self(wcn, vif->addr);
+	}
+	if (ret)
+		list_del(&vif_priv->list);
+
+out_unlock:
 	mutex_unlock(&wcn->conf_mutex);
 
-	return 0;
+	return ret > 0 ? -EIO : ret;
 }
 
 static int wcn36xx_sta_add(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
@@ -1440,6 +1515,9 @@
 		WLAN_CIPHER_SUITE_CCMP,
 	};
 
+	if (wcn->is_pronto && !wcn->is_pronto_v3 &&
+	    wcn->rf_id == RF_IRIS_WCN3660)
+		ieee80211_hw_set(wcn->hw, WANT_MONITOR_VIF);
 	ieee80211_hw_set(wcn->hw, TIMING_BEACON_ONLY);
 	ieee80211_hw_set(wcn->hw, AMPDU_AGGREGATION);
 	ieee80211_hw_set(wcn->hw, SUPPORTS_PS);
diff --git a/drivers/net/wireless/ath/wcn36xx/smd.c b/drivers/net/wireless/ath/wcn36xx/smd.c
--- a/drivers/net/wireless/ath/wcn36xx/smd.c
+++ b/drivers/net/wireless/ath/wcn36xx/smd.c
@@ -1050,6 +1050,12 @@
 	INIT_HAL_MSG(msg_body, WCN36XX_HAL_CH_SWITCH_REQ);
 
 	msg_body.channel_number = (u8)ch;
+	if (conf_is_ht40_minus(&wcn->hw->conf))
+		msg_body.secondary_channel_offset = PHY_DOUBLE_CHANNEL_HIGH_PRIMARY;
+	else if (conf_is_ht40_plus(&wcn->hw->conf))
+		msg_body.secondary_channel_offset = PHY_DOUBLE_CHANNEL_LOW_PRIMARY;
+	else
+		msg_body.secondary_channel_offset = PHY_SINGLE_CHANNEL_CENTERED;
 	msg_body.tx_mgmt_power = 0xbf;
 	msg_body.max_tx_power = 0xbf;
 	memcpy(msg_body.self_sta_mac_addr, vif->addr, ETH_ALEN);
@@ -2378,6 +2384,140 @@
 	}
 out:
 	mutex_unlock(&wcn->hal_mutex);
+	return ret;
+}
+
+#define WCN36XX_MON_RXP_CFG	0xfb080800
+#define WCN36XX_MON_RXP_TYPES_LO	0xfb0808f0
+#define WCN36XX_MON_RXP_TYPES_HI	0xfb0808f4
+#define WCN36XX_MON_DPU_ERROR_WQ	0xfb081874
+#define WCN36XX_MON_DPU_ERROR_IRQ	0xfb081820
+
+/* Commands 7/8 in the tested WCN3660 firmware's HAL dump table. */
+static int wcn36xx_smd_rxp_reg(struct wcn36xx *wcn, u32 addr, u32 *value,
+			       bool write)
+{
+	struct wcn36xx_hal_dump_cmd_req_msg req;
+	struct wcn36xx_hal_dump_cmd_rsp_msg *rsp;
+	int ret;
+
+	if (addr != WCN36XX_MON_RXP_CFG && addr != WCN36XX_MON_RXP_TYPES_LO &&
+	    addr != WCN36XX_MON_RXP_TYPES_HI && addr != WCN36XX_MON_DPU_ERROR_WQ &&
+	    addr != WCN36XX_MON_DPU_ERROR_IRQ)
+		return -EINVAL;
+	mutex_lock(&wcn->hal_mutex);
+	INIT_HAL_MSG(req, WCN36XX_HAL_DUMP_COMMAND_REQ);
+	req.arg1 = write ? 8 : 7;
+	req.arg2 = addr;
+	req.arg3 = write ? *value : 0;
+	req.arg4 = 0;
+	req.arg5 = 0;
+	PREPARE_HAL_BUF(wcn->hal_buf, req);
+	ret = wcn36xx_smd_send_and_wait(wcn, req.header.len);
+	if (ret)
+		goto out;
+	rsp = (void *)wcn->hal_buf;
+	if (wcn->hal_rsp_len < offsetof(typeof(*rsp), rsp_buffer) ||
+	    rsp->header.msg_type != WCN36XX_HAL_DUMP_COMMAND_RSP || rsp->status) {
+		ret = -EPROTO;
+		goto out;
+	}
+	if (!write) {
+		if (rsp->rsp_length != sizeof(*value) ||
+		    wcn->hal_rsp_len < offsetof(typeof(*rsp), rsp_buffer) + sizeof(*value)) {
+			ret = -EPROTO;
+			goto out;
+		}
+		memcpy(value, rsp->rsp_buffer, sizeof(*value));
+	}
+out:
+	mutex_unlock(&wcn->hal_mutex);
+	return ret;
+}
+
+static int wcn36xx_smd_rxp_write(struct wcn36xx *wcn, u32 addr, u32 value)
+{
+	u32 actual;
+	int ret;
+
+	ret = wcn36xx_smd_rxp_reg(wcn, addr, &value, true);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_reg(wcn, addr, &actual, false);
+	if (ret)
+		return ret;
+	return actual == value ? 0 : -EIO;
+}
+
+int wcn36xx_smd_monitor_filter(struct wcn36xx *wcn, bool enable)
+{
+	u32 error_wq;
+	int ret, err;
+
+	/* Register layout/commands are proven only on this stock firmware. */
+	if (!wcn->is_pronto || wcn->is_pronto_v3 ||
+	    wcn->rf_id != RF_IRIS_WCN3660 ||
+	    !wcn36xx_is_fw_version(wcn, 1, 5, 1, 2) ||
+	    strcmp(wcn->crm_version, "12035159"))
+		return -EOPNOTSUPP;
+	if (!enable) {
+		if (!wcn->monitor_filter_saved)
+			return 0;
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_CFG, wcn->monitor_rxp_cfg);
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_LO, wcn->monitor_rxp_lo);
+		if (!ret)
+			ret = err;
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_HI, wcn->monitor_rxp_hi);
+		if (!ret)
+			ret = err;
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_WQ,
+					    wcn->monitor_dpu_error_wq);
+		if (!ret)
+			ret = err;
+		err = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_IRQ,
+					    wcn->monitor_dpu_error_irq);
+		if (!ret)
+			ret = err;
+		if (!ret)
+			wcn->monitor_filter_saved = false;
+		return ret;
+	}
+	ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_RXP_CFG, &wcn->monitor_rxp_cfg, false);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_RXP_TYPES_LO,
+					  &wcn->monitor_rxp_lo, false);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_RXP_TYPES_HI,
+					  &wcn->monitor_rxp_hi, false);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_DPU_ERROR_WQ,
+					  &wcn->monitor_dpu_error_wq, false);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_reg(wcn, WCN36XX_MON_DPU_ERROR_IRQ,
+					  &wcn->monitor_dpu_error_irq, false);
+	if (ret)
+		return ret;
+	wcn->monitor_filter_saved = true;
+	/* Unknown-key frames otherwise go to firmware's DPU error queue (8).
+	 * In standalone monitor, DMA their original ciphertext to host RX (11).
+	 * Mask packet-error IRQs so firmware cannot race the host for those BDs;
+	 * retain fatal/MIC IRQs and all existing DPU packet-filter settings.
+	 */
+	ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_IRQ,
+				    wcn->monitor_dpu_error_irq & ~GENMASK(20, 0));
+	error_wq = (wcn->monitor_dpu_error_wq & ~0xff) | WCN36XX_DXE_WQ_RX_L;
+	if (!ret)
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_DPU_ERROR_WQ, error_wq);
+	if (ret)
+		goto restore;
+	/* Keep RX enabled; bypass address lookup, unmask valid frame types. */
+	ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_CFG, wcn->monitor_rxp_cfg & ~BIT(2));
+	if (!ret)
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_LO, 0xffff0000);
+	if (!ret)
+		ret = wcn36xx_smd_rxp_write(wcn, WCN36XX_MON_RXP_TYPES_HI, 0);
+restore:
+	if (ret)
+		wcn36xx_smd_monitor_filter(wcn, false);
 	return ret;
 }
 
diff --git a/drivers/net/wireless/ath/wcn36xx/smd.h b/drivers/net/wireless/ath/wcn36xx/smd.h
--- a/drivers/net/wireless/ath/wcn36xx/smd.h
+++ b/drivers/net/wireless/ath/wcn36xx/smd.h
@@ -65,6 +65,8 @@
 			    struct ieee80211_vif *vif);
 int wcn36xx_smd_init_scan(struct wcn36xx *wcn, enum wcn36xx_hal_sys_mode mode,
 			  struct ieee80211_vif *vif);
+
+int wcn36xx_smd_monitor_filter(struct wcn36xx *wcn, bool enable);
 
 int wcn36xx_smd_start_hw_scan(struct wcn36xx *wcn, struct ieee80211_vif *vif,
 			      struct cfg80211_scan_request *req);
diff --git a/drivers/net/wireless/ath/wcn36xx/txrx.c b/drivers/net/wireless/ath/wcn36xx/txrx.c
--- a/drivers/net/wireless/ath/wcn36xx/txrx.c
+++ b/drivers/net/wireless/ath/wcn36xx/txrx.c
@@ -348,16 +348,19 @@
 
 	hdr = (struct ieee80211_hdr *) skb->data;
 	fc = __le16_to_cpu(hdr->frame_control);
-	sn = IEEE80211_SEQ_TO_SN(__le16_to_cpu(hdr->seq_ctrl));
+	sn = skb->len >= 24 ? IEEE80211_SEQ_TO_SN(le16_to_cpu(hdr->seq_ctrl)) : 0;
 
 	status.mactime = 10;
 	status.signal = -get_rssi0(bd);
 	status.antenna = 1;
 	status.flag = 0;
 	status.rx_flags = 0;
-	status.flag |= RX_FLAG_IV_STRIPPED |
-		       RX_FLAG_MMIC_STRIPPED |
-		       RX_FLAG_DECRYPTED;
+	if (READ_ONCE(wcn->monitor_enabled))
+		status.flag |= RX_FLAG_ONLY_MONITOR;
+	else
+		status.flag |= RX_FLAG_IV_STRIPPED |
+			       RX_FLAG_MMIC_STRIPPED |
+			       RX_FLAG_DECRYPTED;
 
 	wcn36xx_dbg(WCN36XX_DBG_RX, "status.flags=%x\n", status.flag);
 
diff --git a/drivers/net/wireless/ath/wcn36xx/wcn36xx.h b/drivers/net/wireless/ath/wcn36xx/wcn36xx.h
--- a/drivers/net/wireless/ath/wcn36xx/wcn36xx.h
+++ b/drivers/net/wireless/ath/wcn36xx/wcn36xx.h
@@ -258,6 +258,13 @@
 	struct list_head	hal_ind_queue;
 
 	struct cfg80211_scan_request *scan_req;
+	bool			monitor_enabled;
+	bool			monitor_filter_saved;
+	u32			monitor_rxp_cfg;
+	u32			monitor_rxp_lo;
+	u32			monitor_rxp_hi;
+	u32			monitor_dpu_error_wq;
+	u32			monitor_dpu_error_irq;
 	bool			sw_scan;
 	u8			sw_scan_opchannel;
 	bool			sw_scan_init;
