Subject: [PATCH] wifi: wcn36xx: validate the TX context and raw frame header

Monitor injection need not use a registered interface source address.
Avoid dereferencing a missing TX context, keep NOACK/NOSEQ semantics,
and describe control/4-address headers with their actual length. This
does not change firmware filtering.

---
diff --git a/drivers/net/wireless/ath/wcn36xx/txrx.c b/drivers/net/wireless/ath/wcn36xx/txrx.c
--- a/drivers/net/wireless/ath/wcn36xx/txrx.c
+++ b/drivers/net/wireless/ath/wcn36xx/txrx.c
@@ -468,17 +468,28 @@
 	bd->pdu.tid = tid;
 }
 
-static inline struct wcn36xx_vif *get_vif_by_addr(struct wcn36xx *wcn,
-						  u8 *addr)
-{
-	struct wcn36xx_vif *vif_priv = NULL;
-	struct ieee80211_vif *vif = NULL;
+static struct wcn36xx_vif *wcn36xx_tx_vif(struct wcn36xx *wcn,
+					  struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_hdr *hdr = (void *)skb->data;
+	struct wcn36xx_vif *vif_priv;
+
 	list_for_each_entry(vif_priv, &wcn->vif_list, list) {
-			vif = wcn36xx_priv_to_vif(vif_priv);
-			if (memcmp(vif->addr, addr, ETH_ALEN) == 0)
-				return vif_priv;
-	}
-	wcn36xx_warn("vif %pM not found\n", addr);
+		struct ieee80211_vif *vif = wcn36xx_priv_to_vif(vif_priv);
+
+		if (vif == info->control.vif ||
+		    (skb->len >= 16 && ether_addr_equal(vif->addr, hdr->addr2)))
+			return vif_priv;
+	}
+
+	/*
+	 * A raw monitor frame need not use a registered source address.
+	 * Use a firmware TX context, never an uninitialised monitor drv_priv.
+	 */
+	if (info->flags & IEEE80211_TX_CTL_INJECTED)
+		return list_first_entry_or_null(&wcn->vif_list,
+					       struct wcn36xx_vif, list);
 	return NULL;
 }
 
@@ -517,7 +528,7 @@
 	spin_unlock(&sta_priv->ampdu_lock);
 }
 
-static void wcn36xx_set_tx_data(struct wcn36xx_tx_bd *bd,
+static bool wcn36xx_set_tx_data(struct wcn36xx_tx_bd *bd,
 				struct wcn36xx *wcn,
 				struct wcn36xx_vif **vif_priv,
 				struct wcn36xx_sta *sta_priv,
@@ -552,7 +563,9 @@
 			bd->dpu_desc_idx = sta_priv->dpu_desc_index;
 		}
 	} else {
-		__vif_priv = get_vif_by_addr(wcn, hdr->addr2);
+		__vif_priv = wcn36xx_tx_vif(wcn, skb);
+		if (!__vif_priv)
+			return false;
 		bd->sta_index = __vif_priv->self_sta_index;
 		bd->dpu_desc_idx = __vif_priv->self_dpu_desc_index;
 		bd->dpu_sign = __vif_priv->self_ucast_dpu_sign;
@@ -587,16 +600,15 @@
 	*vif_priv = __vif_priv;
 
 	wcn36xx_set_tx_pdu(bd,
-			   is_data_qos ?
-			   sizeof(struct ieee80211_qos_hdr) :
-			   sizeof(struct ieee80211_hdr_3addr),
+			   ieee80211_hdrlen(hdr->frame_control),
 			   skb->len, tid);
 
 	if (sta_priv && is_data_qos)
 		wcn36xx_tx_start_ampdu(wcn, sta_priv, skb);
-}
-
-static void wcn36xx_set_tx_mgmt(struct wcn36xx_tx_bd *bd,
+	return true;
+}
+
+static bool wcn36xx_set_tx_mgmt(struct wcn36xx_tx_bd *bd,
 				struct wcn36xx *wcn,
 				struct wcn36xx_vif **vif_priv,
 				struct sk_buff *skb,
@@ -604,13 +616,17 @@
 {
 	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
 	struct wcn36xx_vif *__vif_priv =
-		get_vif_by_addr(wcn, hdr->addr2);
+		wcn36xx_tx_vif(wcn, skb);
+
+	if (!__vif_priv)
+		return false;
 	bd->sta_index = __vif_priv->self_sta_index;
 	bd->dpu_desc_idx = __vif_priv->self_dpu_desc_index;
 	bd->dpu_ne = 1;
 
 	/* default rate for unicast */
-	if (ieee80211_is_mgmt(hdr->frame_control))
+	if (ieee80211_is_mgmt(hdr->frame_control) ||
+	    ieee80211_is_data(hdr->frame_control))
 		bd->bd_rate = (WCN36XX_BAND(wcn) == NL80211_BAND_5GHZ) ?
 			WCN36XX_BD_RATE_CTRL :
 			WCN36XX_BD_RATE_MGMT;
@@ -640,10 +656,9 @@
 	bd->pdu.bd_ssn = WCN36XX_TXBD_SSN_FILL_DPU_NON_QOS;
 
 	wcn36xx_set_tx_pdu(bd,
-			   ieee80211_is_data_qos(hdr->frame_control) ?
-			   sizeof(struct ieee80211_qos_hdr) :
-			   sizeof(struct ieee80211_hdr_3addr),
+			   ieee80211_hdrlen(hdr->frame_control),
 			   skb->len, WCN36XX_TID);
+	return true;
 }
 
 int wcn36xx_start_tx(struct wcn36xx *wcn,
@@ -653,44 +668,49 @@
 	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
 	struct wcn36xx_vif *vif_priv = NULL;
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
-	bool is_low = ieee80211_is_data(hdr->frame_control);
-	bool bcast = is_broadcast_ether_addr(hdr->addr1) ||
-		is_multicast_ether_addr(hdr->addr1);
+	bool is_low, bcast;
 	bool ack_ind = (info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS) &&
 					!(info->flags & IEEE80211_TX_CTL_NO_ACK);
 	struct wcn36xx_tx_bd bd;
 	int ret;
 
+	if (unlikely(skb->len < 10 ||
+		     skb->len < ieee80211_hdrlen(hdr->frame_control)))
+		return -EINVAL;
+
+	is_low = ieee80211_is_data(hdr->frame_control) &&
+		 !(info->flags & IEEE80211_TX_CTL_INJECTED);
+	bcast = is_multicast_ether_addr(hdr->addr1);
 	memset(&bd, 0, sizeof(bd));
 
 	wcn36xx_dbg(WCN36XX_DBG_TX,
 		    "tx skb %p len %d fc %04x sn %d %s %s\n",
 		    skb, skb->len, __le16_to_cpu(hdr->frame_control),
-		    IEEE80211_SEQ_TO_SN(__le16_to_cpu(hdr->seq_ctrl)),
+		    skb->len >= 24 ?
+			IEEE80211_SEQ_TO_SN(le16_to_cpu(hdr->seq_ctrl)) : 0,
 		    is_low ? "low" : "high", bcast ? "bcast" : "ucast");
 
 	wcn36xx_dbg_dump(WCN36XX_DBG_TX_DUMP, "", skb->data, skb->len);
 
 	bd.dpu_rf = WCN36XX_BMU_WQ_TX;
 
+	/* Prepare the descriptor before stopping queues for ACK reporting. */
+	if (is_low) {
+		if (!wcn36xx_set_tx_data(&bd, wcn, &vif_priv, sta_priv, skb, bcast))
+			return -ENOTCONN;
+	} else if (!wcn36xx_set_tx_mgmt(&bd, wcn, &vif_priv, skb, bcast)) {
+		return -ENOTCONN;
+	}
+
+	if (info->flags & IEEE80211_TX_CTL_NO_ACK)
+		bd.ack_policy = 1;
+	if (info->control.flags & IEEE80211_TX_CTRL_NO_SEQNO)
+		bd.pdu.bd_ssn = WCN36XX_TXBD_SSN_FILL_HOST;
+
 	if (unlikely(ack_ind)) {
-		wcn36xx_dbg(WCN36XX_DBG_DXE, "TX_ACK status requested\n");
-
-		/* Only one at a time is supported by fw. Stop the TX queues
-		 * until the ack status gets back.
-		 */
 		ieee80211_stop_queues(wcn->hw);
-
-		/* Request ack indication from the firmware */
 		bd.tx_comp = 1;
 	}
-
-	/* Data frames served first*/
-	if (is_low)
-		wcn36xx_set_tx_data(&bd, wcn, &vif_priv, sta_priv, skb, bcast);
-	else
-		/* MGMT and CTRL frames are handeld here*/
-		wcn36xx_set_tx_mgmt(&bd, wcn, &vif_priv, skb, bcast);
 
 	buff_to_be(&bd, sizeof(bd)/sizeof(u32));
 	bd.tx_bd_sign = 0xbdbdbdbd;
