From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Tue, 13 Oct 2026 15:00:00 +0700
Subject: [PATCH] drm/simpledrm: control optional backlight with CRTC

Firmware framebuffers can keep scanning while the compositor disables
the CRTC. Blanking framebuffer pixels alone leaves an independently
controlled panel backlight illuminated, including during system sleep.

Accept an optional standard backlight phandle. Use the existing
backlight helpers in CRTC enable/disable and propagate deferred probing.
The standard phandle supplies the inferred supplier link. Brightness is
retained across blanking. Framebuffers without this property keep their
existing behaviour.

This controls illumination only; the inherited display scanout, bridge
and panel power still require their native DRM drivers for complete
display PM.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/sysfb/simpledrm.c b/drivers/gpu/drm/sysfb/simpledrm.c
--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
 #include <linux/aperture.h>
+#include <linux/backlight.h>
 #include <linux/clk.h>
 #include <linux/minmax.h>
 #include <linux/of_address.h>
@@ -249,6 +250,8 @@
 	struct device **pwr_dom_devs;
 	struct device_link **pwr_dom_links;
 #endif
+
+	struct backlight_device *backlight;
 
 	/* modesetting */
 	u32 formats[DRM_SYSFB_PLANE_NFORMATS(1)];
@@ -588,8 +591,32 @@
 	.destroy = drm_plane_cleanup,
 };
 
+static void simpledrm_crtc_atomic_enable(struct drm_crtc *crtc,
+					struct drm_atomic_commit *state)
+{
+	struct simpledrm_device *sdev = container_of(crtc, struct simpledrm_device, crtc);
+	int ret;
+
+	ret = backlight_enable(sdev->backlight);
+	if (ret)
+		drm_err(crtc->dev, "Failed to enable backlight: %d\n", ret);
+}
+
+static void simpledrm_crtc_atomic_disable(struct drm_crtc *crtc,
+					 struct drm_atomic_commit *state)
+{
+	struct simpledrm_device *sdev = container_of(crtc, struct simpledrm_device, crtc);
+	int ret;
+
+	ret = backlight_disable(sdev->backlight);
+	if (ret)
+		drm_err(crtc->dev, "Failed to disable backlight: %d\n", ret);
+}
+
 static const struct drm_crtc_helper_funcs simpledrm_crtc_helper_funcs = {
 	DRM_SYSFB_CRTC_HELPER_FUNCS,
+	.atomic_enable = simpledrm_crtc_atomic_enable,
+	.atomic_disable = simpledrm_crtc_atomic_disable,
 };
 
 static const struct drm_crtc_funcs simpledrm_crtc_funcs = {
@@ -649,6 +676,10 @@
 	/*
 	 * Hardware settings
 	 */
+
+	sdev->backlight = devm_of_find_backlight(&pdev->dev);
+	if (IS_ERR(sdev->backlight))
+		return ERR_CAST(sdev->backlight);
 
 	ret = simpledrm_device_init_clocks(sdev);
 	if (ret)
diff --git a/drivers/gpu/drm/sysfb/Kconfig b/drivers/gpu/drm/sysfb/Kconfig
--- a/drivers/gpu/drm/sysfb/Kconfig
+++ b/drivers/gpu/drm/sysfb/Kconfig
@@ -57,6 +57,7 @@
 config DRM_SIMPLEDRM
 	tristate "Simple framebuffer driver"
 	depends on DRM && MMU
+	depends on BACKLIGHT_CLASS_DEVICE || !BACKLIGHT_CLASS_DEVICE
 	select APERTURE_HELPERS
 	select DRM_CLIENT_SELECTION
 	select DRM_GEM_SHMEM_HELPER
-- 
