diff --git a/tests/test-ambient.c b/tests/test-ambient.c
new file mode 100644
--- /dev/null
+++ b/tests/test-ambient.c
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 T531 Project
+ */
+
+/* Exercise the real ambient state machine with delayed successful D-Bus calls.
+ * SensorProxy can accept ClaimLight even when HasAmbientLight is false.
+ */
+#define phosh_dbus_sensor_proxy_call_claim_light mock_claim_light
+#define phosh_dbus_sensor_proxy_call_claim_light_finish mock_claim_light_finish
+#define phosh_dbus_sensor_proxy_call_release_light mock_release_light
+#define phosh_dbus_sensor_proxy_call_release_light_finish mock_release_light_finish
+#define phosh_dbus_sensor_proxy_call_release_light_sync mock_release_light_sync
+#include "../src/ambient.c"
+
+static GTask *pending_claim, *pending_release;
+static guint claims, releases;
+
+void
+mock_claim_light (PhoshDBusSensorProxy *proxy, GCancellable *cancel,
+                  GAsyncReadyCallback callback, gpointer data)
+{
+  g_assert_null (pending_claim);
+  claims++;
+  pending_claim = g_task_new (proxy, cancel, callback, data);
+}
+
+gboolean
+mock_claim_light_finish (PhoshDBusSensorProxy *proxy, GAsyncResult *res, GError **error)
+{
+  return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+void
+mock_release_light (PhoshDBusSensorProxy *proxy, GCancellable *cancel,
+                    GAsyncReadyCallback callback, gpointer data)
+{
+  g_assert_null (pending_release);
+  releases++;
+  pending_release = g_task_new (proxy, cancel, callback, data);
+}
+
+gboolean
+mock_release_light_finish (PhoshDBusSensorProxy *proxy, GAsyncResult *res, GError **error)
+{
+  return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+gboolean
+mock_release_light_sync (PhoshDBusSensorProxy *proxy, GCancellable *cancel, GError **error)
+{
+  return TRUE;
+}
+
+static void
+complete (GTask **pending)
+{
+  GTask *task = g_steal_pointer (pending);
+
+  g_assert_nonnull (task);
+  g_task_return_boolean (task, TRUE);
+  g_object_unref (task);
+  while (g_main_context_iteration (NULL, FALSE));
+}
+
+static PhoshAmbient *
+new_ambient (void)
+{
+  PhoshAmbient *self;
+  GDBusProxy *proxy;
+
+  /* Run instance initialization without constructing a complete desktop shell. */
+  self = (PhoshAmbient *) g_type_create_instance (PHOSH_TYPE_AMBIENT);
+  self->sensor_proxy_manager = g_object_new (PHOSH_TYPE_SENSOR_PROXY_MANAGER, NULL);
+  proxy = G_DBUS_PROXY (self->sensor_proxy_manager);
+  g_dbus_proxy_set_cached_property (proxy, "HasAmbientLight", g_variant_new_boolean (FALSE));
+  g_dbus_proxy_set_cached_property (proxy, "LightLevel", g_variant_new_double (0));
+  g_dbus_proxy_set_cached_property (proxy, "LightLevelUnit", g_variant_new_string ("lux"));
+  self->blanked = FALSE;
+  g_settings_set_boolean (self->power_settings, KEY_AMBIENT_ENABLED, TRUE);
+  g_settings_set_boolean (self->phosh_settings, KEY_AUTOMATIC_HC, FALSE);
+  claims = releases = 0;
+  return self;
+}
+
+static void
+set_sensor (PhoshAmbient *self, gboolean present)
+{
+  PhoshDBusSensorProxy *proxy = PHOSH_DBUS_SENSOR_PROXY (self->sensor_proxy_manager);
+
+  g_dbus_proxy_set_cached_property (G_DBUS_PROXY (proxy), "HasAmbientLight",
+                                     g_variant_new_boolean (present));
+  on_has_ambient_light_changed (self, NULL, proxy);
+}
+
+static void
+test_absent_sensor (void)
+{
+  g_autoptr (PhoshAmbient) self = new_ambient ();
+
+  set_sensor (self, FALSE);
+  maybe_claim (self);
+  maybe_claim (self);
+  g_assert_cmpuint (claims, ==, 0);
+  g_assert_cmpuint (releases, ==, 0);
+  g_assert_false (phosh_ambient_get_auto_brightness (self));
+  g_assert_cmpfloat (phosh_ambient_get_light_level (self), ==, -1.0);
+}
+
+static void
+test_sensor_lifecycle (void)
+{
+  g_autoptr (PhoshAmbient) self = new_ambient ();
+
+  set_sensor (self, TRUE);
+  maybe_claim (self);  /* A repeated event must not send a second async claim. */
+  g_assert_cmpuint (claims, ==, 1);
+  g_assert_false (phosh_ambient_get_auto_brightness (self));
+  complete (&pending_claim);
+  g_assert_true (phosh_ambient_get_auto_brightness (self));
+  g_assert_cmpfloat (phosh_ambient_get_light_level (self), ==, 0.0);
+
+  set_sensor (self, FALSE);
+  g_assert_false (phosh_ambient_get_auto_brightness (self));
+  g_assert_cmpuint (releases, ==, 1);
+  set_sensor (self, FALSE);
+  g_assert_cmpuint (releases, ==, 1);
+  complete (&pending_release);
+  g_assert_cmpint (self->claimed, ==, 0);
+
+  set_sensor (self, TRUE);
+  complete (&pending_claim);
+  g_assert_cmpuint (claims, ==, 2);
+  g_assert_true (phosh_ambient_get_auto_brightness (self));
+  set_sensor (self, FALSE);
+  complete (&pending_release);
+}
+
+static void
+test_vanish_while_claiming (void)
+{
+  g_autoptr (PhoshAmbient) self = new_ambient ();
+
+  set_sensor (self, TRUE);
+  set_sensor (self, FALSE);
+  g_assert_cmpuint (releases, ==, 0);
+  complete (&pending_claim);
+  g_assert_false (phosh_ambient_get_auto_brightness (self));
+  g_assert_cmpfloat (phosh_ambient_get_light_level (self), ==, -1.0);
+  g_assert_cmpuint (releases, ==, 1);
+  complete (&pending_release);
+  g_assert_cmpint (self->claimed, ==, 0);
+}
+
+static void
+test_reappear_while_releasing (void)
+{
+  g_autoptr (PhoshAmbient) self = new_ambient ();
+
+  set_sensor (self, TRUE);
+  complete (&pending_claim);
+  set_sensor (self, FALSE);
+  set_sensor (self, TRUE);
+  g_assert_cmpuint (claims, ==, 1);
+  complete (&pending_release);
+  g_assert_cmpuint (claims, ==, 2);
+  g_assert_false (phosh_ambient_get_auto_brightness (self));
+  complete (&pending_claim);
+  g_assert_true (phosh_ambient_get_auto_brightness (self));
+  set_sensor (self, FALSE);
+  complete (&pending_release);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/phosh/ambient/no-sensor", test_absent_sensor);
+  g_test_add_func ("/phosh/ambient/lifecycle", test_sensor_lifecycle);
+  g_test_add_func ("/phosh/ambient/vanish-while-claiming", test_vanish_while_claiming);
+  g_test_add_func ("/phosh/ambient/reappear-while-releasing", test_reappear_while_releasing);
+  return g_test_run ();
+}
