# Built-in early storage, input, framebuffer and USB diagnostics.
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_INPUT_EVDEV=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_IIO_ST_ACCEL_3AXIS=y
CONFIG_BACKLIGHT_LP855X=y
CONFIG_PWM_CLK=y
CONFIG_I2C_GPIO=y
CONFIG_EXTCON_SM5502=y
CONFIG_QCOM_TSENS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_USB_ULPI_BUS=y
CONFIG_QCOM_OCMEM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_28NM_PHY=y
CONFIG_DRM_TOSHIBA_TC358764=y
CONFIG_DRM_PANEL_LVDS=y
CONFIG_CHARGER_SMB347=y
CONFIG_BATTERY_QCOM_PM8226_BMS=y
CONFIG_QCOM_SPMI_IADC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

CONFIG_ARM_SMMU=y
CONFIG_IOMMU_IO_PGTABLE_ARMV7S=y
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_FB_SIMPLE is not set
CONFIG_QCOM_COMMAND_DB=y

# Use the appended FDT directly; the immutable loader already supplies FDT.
# CONFIG_ARM_ATAG_DTB_COMPAT is not set

CONFIG_I2C_CHARDEV=y
CONFIG_QCOM_WCNSS_PIL=y
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_WCN36XX=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_QCOM_SYSMON=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_FUSE_FS=y

# The read-only PMIC RTC returns 1971; use timesyncd saved time and NTP.
# CONFIG_RTC_HCTOSYS is not set

# UPower uses PrivateUsers in its standard service sandbox.
CONFIG_USER_NS=y

# No wired UART console is available; keep serial BREAK from invoking SysRq.
# CONFIG_MAGIC_SYSRQ_SERIAL is not set

# SM-T531 uses MSM8226 MDP5/DSI. Keep unrelated built-ins out of its fixed
# decompressor/appended-DTB workspace below firmware scanout at 0x03200000.
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_HDMI is not set
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
